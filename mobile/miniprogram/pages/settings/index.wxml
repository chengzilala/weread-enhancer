<view class="wre-page {{wreDark ? 'wre-dark' : ''}}" style="--wre-fs:{{wreFs}}">

  <!-- 1. 我的账户：账户区置顶（我是谁 / 账户安全）+ 关联与备份 -->
  <view class="wre-card">
    <view class="wre-title">我的账户</view>

    <block wx:if="{{psUser}}">
      <view class="ps-row">
        <image class="ps-avatar" wx:if="{{psUser.avatar}}" src="{{psUser.avatar}}" mode="aspectFill" />
        <view class="ps-avatar ps-avatar--empty" wx:else>{{psInitial}}</view>
        <view class="ps-main">
          <text class="ps-nick">{{psUser.nickname || '微信用户'}}</text>
          <text class="ps-uid">UID {{psUid}} · 一个 uid 管所有作品</text>
        </view>
      </view>
      <view class="wre-btn-row">
        <button class="wre-btn wre-btn--ghost" bindtap="copyAccount">账户中心</button>
        <button class="wre-btn wre-btn--ghost" loading="{{psBusy}}" bindtap="onPsLogout">退出</button>
      </view>

      <!-- 账户安全：登录方式 / 绑定 / 注销 -->
      <view class="wre-row {{openSec === 'security' ? 'is-open' : ''}}" data-sec="security" bindtap="onToggleSec">
        <text class="wre-row__label">账户安全</text>
        <text class="wre-row__val">登录方式 · 绑定 · 注销</text>
        <text class="wre-row__arrow">{{openSec === 'security' ? '▴' : '▾'}}</text>
      </view>
      <view wx:if="{{openSec === 'security'}}" class="wre-acc">
        <view class="params">
          <view class="params__row" wx:for="{{psKeys}}" wx:key="masked">
            <text class="params__label">{{item.label}}</text>
            <text class="params__value">{{item.masked}}</text>
          </view>
          <view class="params__row" wx:if="{{!psKeys.length}}">
            <text class="params__label">登录方式</text>
            <text class="params__value">微信</text>
          </view>
        </view>
        <view class="wre-muted">想把微信绑到你网页端已有的账户？先在浏览器打开 account.chesterlee.cn 登录并「生成登录码」，再回这里输入 6 位数字。</view>
        <view class="wre-btn-row">
          <button class="wre-btn wre-btn--ghost" bindtap="onPsBind">6 位码绑定</button>
          <button class="wre-btn wre-btn--ghost" bindtap="copyAccount">账户中心</button>
        </view>
        <view class="acc-danger" bindtap="onPsDelete">{{psDeleting ? '正在注销…' : '注销账户（不可恢复）'}}</view>
      </view>
    </block>

    <block wx:else>
      <view class="wre-muted">登录后同一个身份走遍官网、H5 与小程序；与本机账户码、云端 Key 互不影响。</view>
      <view class="wre-btn-row">
        <button class="wre-btn" loading="{{psBusy}}" bindtap="onPsLogin">微信一键登录</button>
      </view>
      <view class="ps-bind" bindtap="onPsBind">已有账户？用 6 位登录码绑定 →</view>
    </block>

    <view class="wre-row" bindtap="goLink">
      <text class="wre-row__label">关联网页账户 · 跨设备登录</text>
      <text class="wre-row__val">{{linked ? '已关联' : '未关联'}}</text>
      <text class="wre-row__arrow">›</text>
    </view>

    <view class="wre-row {{openSec === 'cloud' ? 'is-open' : ''}}" data-sec="cloud" bindtap="onToggleSec">
      <text class="wre-row__label">云端备份</text>
      <text class="wre-row__val">{{hosted ? '已托管' : '无备份'}}</text>
      <text class="wre-row__arrow">{{openSec === 'cloud' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'cloud'}}" class="wre-acc">
      <view class="wre-muted">Key 加密托管在云端；换手机、重装微信或退出登录后，可用账户码找回。</view>
      <view class="wre-code-row">
        <text class="wre-code-row__label">我的账户码</text>
        <text class="wre-code-row__val">{{myCode ? (showCode ? myCode : myCodeMasked) : '尚未生成'}}</text>
        <text wx:if="{{!myCode}}" class="wre-row__link" bindtap="onEnsureCode">生成</text>
        <block wx:else>
          <text class="wre-row__link" bindtap="onToggleCode">{{showCode ? '隐藏' : '显示'}}</text>
          <text class="wre-row__link" bindtap="onCopyCode">复制</text>
        </block>
      </view>
      <button wx:if="{{hosted && !hasKey}}" class="wre-btn" loading="{{restoring}}" bindtap="onRestoreAccount">恢复我的账号</button>
      <view wx:else class="wre-hint">{{hosted ? '本机已连接，无需恢复。' : '保存 Key 后会自动生成云端备份。'}}</view>
    </view>
  </view>

  <!-- 2. 微信读书 Key：全页唯一主操作，已配置时收缩成一行 -->
  <view class="wre-card {{hasKey ? '' : 'wre-card--hero'}}">
    <view class="wre-title wre-title--row">
      <text>微信读书 Key</text>
      <text class="wre-chip {{hasKey ? 'is-on' : ''}}">{{hasKey ? '已连接' : '未连接'}}</text>
    </view>

    <block wx:if="{{hasKey && !showKeyForm}}">
      <view class="wre-code-row">
        <text class="wre-code-row__label">已加密托管</text>
        <text class="wre-code-row__val">{{masked}}</text>
      </view>
      <view class="wre-btn-row">
        <button class="wre-btn wre-btn--ghost" bindtap="onToggleKeyForm">更换</button>
        <button class="wre-btn wre-btn--ghost" bindtap="onClear">清除</button>
      </view>
    </block>
    <block wx:else>
      <view class="wre-muted">{{hasKey ? '粘贴新的 Key 覆盖旧的。' : 'AI 解析需要它；只提交一次加密托管到你的云端账号，换机可一键恢复。'}}</view>
      <input
        class="settings-input"
        type="text"
        password="{{true}}"
        placeholder="粘贴 wrk- 开头的 API Key"
        value="{{input}}"
        bindinput="onInput"
      />
      <button class="wre-btn" loading="{{saving}}" bindtap="onSave">保存并校验</button>
      <view wx:if="{{hasKey}}" class="wre-btn-row">
        <button class="wre-btn wre-btn--ghost" bindtap="onToggleKeyForm">取消更换</button>
      </view>
    </block>

    <view class="settings-status settings-status--{{statusType}}" wx:if="{{statusText}}">{{statusText}}</view>

    <!-- 如何获取 Key：默认收起 -->
    <view class="wre-row {{openSec === 'keyguide' ? 'is-open' : ''}}" data-sec="keyguide" bindtap="onToggleSec">
      <text class="wre-row__label">不知道怎么拿 Key？</text>
      <text class="wre-row__val">3 步图文</text>
      <text class="wre-row__arrow">{{openSec === 'keyguide' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'keyguide'}}" class="wre-acc">
      <view class="key-guide__step" wx:for="{{keyGuideSteps}}" wx:key="no">
        <view class="key-guide__row">
          <view class="key-guide__no">{{item.no}}</view>
          <view class="key-guide__text">{{item.text}}</view>
        </view>
        <image class="key-guide__img" src="{{item.img}}" mode="widthFix" lazy-load="{{true}}" />
      </view>
      <view class="key-guide__tip">小提示：第 ① 步的安装指令是给 AI 助手用的，这里用不到；只要第 ② 步的 Key 就够了。</view>
    </view>
  </view>

  <!-- 3. 更多：设置 / 装到桌面 / 相关入口 / 反馈与交流 全部收成一行入口 -->
  <view class="wre-card">
    <view class="wre-title">更多</view>

    <view class="wre-row {{openSec === 'prefs' ? 'is-open' : ''}}" data-sec="prefs" bindtap="onToggleSec">
      <text class="wre-row__label">设置</text>
      <text class="wre-row__val">{{fsLabel}} · {{themeLabel}}</text>
      <text class="wre-row__arrow">{{openSec === 'prefs' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'prefs'}}" class="wre-acc">
      <view class="wre-acc__label">文字大小</view>
      <view class="fs-modes">
        <view
          wx:for="{{fontTiers}}"
          wx:key="key"
          class="fs-mode {{item.value === wreFs ? 'is-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onFontScale"
        >{{item.label}}</view>
      </view>
      <view class="wre-acc__label">外观</view>
      <view class="theme-modes">
        <view
          wx:for="{{themeTiers}}"
          wx:key="key"
          class="theme-mode {{item.key === themePref ? 'is-active' : ''}}"
          data-value="{{item.key}}"
          bindtap="onTheme"
        >{{item.label}}</view>
      </view>
      <view class="wre-hint">只存本机，换设备需重设。</view>
    </view>

    <view class="wre-row {{openSec === 'desktop' ? 'is-open' : ''}}" data-sec="desktop" bindtap="onToggleSec">
      <text class="wre-row__label">装到桌面</text>
      <text class="wre-row__val">安卓 / iPhone</text>
      <text class="wre-row__arrow">{{openSec === 'desktop' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'desktop'}}" class="wre-acc">
      <view class="wre-muted">加到桌面后，从图标一点就直接打开本小程序，不用每次翻微信找入口。安卓可加到桌面；iPhone 不能加到桌面，可加到「我的小程序」。</view>
      <view class="desktop-guide__group" wx:for="{{desktopGuideGroups}}" wx:key="title">
        <view class="desktop-guide__group-title">{{item.title}}</view>
        <view
          class="desktop-guide__row"
          wx:for="{{item.steps}}"
          wx:for-item="step"
          wx:for-index="idx"
          wx:key="*this"
        >
          <view class="desktop-guide__no">{{idx + 1}}</view>
          <view class="desktop-guide__text">{{step}}</view>
        </view>
      </view>
      <view class="desktop-guide__tip">若桌面没看到图标，左右翻页找一下，或用桌面搜索「悦读且住」。加到「我的小程序」后，在微信首页下拉就能快速打开。</view>
    </view>

    <view class="wre-row {{openSec === 'links' ? 'is-open' : ''}}" data-sec="links" bindtap="onToggleSec">
      <text class="wre-row__label">相关入口</text>
      <text class="wre-row__val">官网 / H5 / 个人网站</text>
      <text class="wre-row__arrow">{{openSec === 'links' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'links'}}" class="wre-acc">
      <view class="wre-muted">小程序里不能直接打开网页，点一下会复制链接，再到浏览器粘贴访问即可。</view>
      <view class="settings-link" bindtap="copySite">
        <view class="settings-link__main">
          <text class="settings-link__label">🌐 官网 · 插件下载与教程</text>
          <text class="settings-link__desc">电脑端插件的安装、使用教程都在这</text>
        </view>
        <text class="settings-link__arrow">›</text>
      </view>
      <view class="settings-link" bindtap="copyH5">
        <view class="settings-link__main">
          <text class="settings-link__label">📱 H5 网页版 · 带 AI 深度解析</text>
          <text class="settings-link__desc">手机浏览器打开，复制链接后用浏览器访问</text>
        </view>
        <text class="settings-link__arrow">›</text>
      </view>
      <view class="settings-link" bindtap="copyPersonal">
        <view class="settings-link__main">
          <text class="settings-link__label">👤 我的个人网站</text>
          <text class="settings-link__desc">作者的其他作品与文章</text>
        </view>
        <text class="settings-link__arrow">›</text>
      </view>
    </view>

    <view class="wre-row" bindtap="goPaperbook">
      <text class="wre-row__label">📚 我的纸书</text>
      <text class="wre-row__arrow">›</text>
    </view>
    <view class="wre-row" bindtap="goNotes">
      <text class="wre-row__label">笔记概览</text>
      <text class="wre-row__arrow">›</text>
    </view>
    <view class="wre-row" bindtap="goDaily">
      <text class="wre-row__label">每日卡片 · 往期回顾</text>
      <text class="wre-row__arrow">›</text>
    </view>
    <view class="wre-row" bindtap="goWander">
      <text class="wre-row__label">灵感漫游 · 往期归档</text>
      <text class="wre-row__arrow">›</text>
    </view>
    <view class="wre-row" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <text class="wre-row__label">📊 运营看板</text>
      <text class="wre-row__arrow">›</text>
    </view>

    <view class="wre-row {{openSec === 'feedback' ? 'is-open' : ''}}" data-sec="feedback" bindtap="onToggleSec">
      <text class="wre-row__label">💬 反馈与交流</text>
      <text class="wre-row__arrow">{{openSec === 'feedback' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'feedback'}}" class="wre-acc">
      <view class="wre-muted">使用中遇到问题，或有想法想聊？扫码加我的微信，直接告诉我。</view>
      <view class="feedback-code">
        <image class="feedback-qr" src="{{feedbackQr}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
        <text class="feedback-label">扫一扫，添加我的微信</text>
      </view>
    </view>

    <view class="wre-row {{openSec === 'about' ? 'is-open' : ''}}" data-sec="about" bindtap="onToggleSec">
      <text class="wre-row__label">关于与说明</text>
      <text class="wre-row__arrow">{{openSec === 'about' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'about'}}" class="wre-acc">
      <view class="wre-muted">小程序为合规精简版：只在手机本机按规则展示你的阅读数据，不含 AI 深度解析；网页版提供 AI 人格画像、每日卡片与灵感漫游主题综述。</view>
      <view class="settings-help">1. Key 在微信读书 App →「我」→「微信读书 Skill」复制（wrk- 开头）。</view>
      <view class="settings-help">2. Key 会在本机缓存一份，并加密托管到你的云端账号；卸载、清缓存或换手机后可用账户码恢复。</view>
      <view class="settings-help">3. 清除 Key 后，首页 / 人格 / 报告 / 书架会回到引导状态。</view>
      <view class="settings-help">4. 头像昵称可选，仅存本机、不上传。</view>
      <view class="settings-help">5. 阅读报告、人格、每日卡片、灵感漫游、纸书归档均在本机按固定规则计算；除阅读报告外，结果会按你的账号加密存一份在云端，用于换机找回。</view>
    </view>

    <view class="wre-row {{openSec === 'params' ? 'is-open' : ''}}" data-sec="params" bindtap="onToggleSec">
      <text class="wre-row__label">参数详情</text>
      <text class="wre-row__arrow">{{openSec === 'params' ? '▴' : '▾'}}</text>
    </view>
    <view wx:if="{{openSec === 'params'}}" class="wre-acc">
      <view class="params">
        <view class="params__row" wx:for="{{params}}" wx:key="label">
          <text class="params__label">{{item.label}}</text>
          <text class="params__value">{{item.value}}</text>
        </view>
        <view class="params__row" wx:if="{{myOpenid}}">
          <text class="params__label">我的 openid</text>
          <text class="params__value">{{myOpenid}}</text>
        </view>
      </view>
      <button class="wre-btn wre-btn--ghost" wx:if="{{myOpenid}}" bindtap="copyOpenid">复制 openid</button>
      <view class="wre-hint">仅展示本机可见的配置项与掩码，不显示 Key 明文。openid 仅你自己可见；开启运营看板时，把它填进云函数环境变量 ADMIN_OPENIDS 即可。</view>
    </view>
  </view>

  <!-- 页尾：退出登录（弱化） -->
  <view class="wre-foot">
    <view class="wre-foot__btn" bindtap="onSignOut">{{signingOut ? '正在退出…' : '退出登录'}}</view>
  </view>
</view>
