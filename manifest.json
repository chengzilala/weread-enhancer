{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.27.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "homepage_url": "https://wereadapp-32km31c.maozi.io",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://i.weread.qq.com/*",
    "https://api.deepseek.com/*",
    "https://wereadapp-32km31c.maozi.io/*",
    "https://*.tcloudbase.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/donate/wechat.png",
        "assets/donate/alipay.png",
        "assets/feedback/wechat.png",
        "assets/wechat-mp/qrcode.png"
      ],
      "matches": [
        "*://weread.qq.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://weread.qq.com/*"
      ],
      "css": [
        "content.css",
        "modules/stats.css",
        "modules/notes.css",
        "modules/tts.css",
        "modules/official.css",
        "modules/finder.css",
        "modules/home-shelf.css",
        "modules/support-center.css",
        "modules/backup.css",
        "modules/help.css"
      ],
      "js": [
        "modules/stats.js",
        "modules/tts.js",
        "modules/notes.js",
        "modules/official.js",
        "modules/pinyin-data.js",
        "modules/finder.js",
        "modules/home-shelf.js",
        "modules/support-center.js",
        "modules/backup.js",
        "modules/help.js",
        "modules/telemetry.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
