<view class="wre-page">
  <!-- 分享图绘制画布（移出屏幕外，不可见） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

  <!-- 无 Key 引导 -->
  <wre-state
    wx:if="{{!hasKey}}"
    type="nokey"
    text="还没有配置微信读书 API Key"
    sub="配置后即可从你的历史划线 / 想法里取材，编排每周主题合辑"
    action="去配置 Key"
    actionType="settings"
    bind:action="onStateAction"
  />

  <block wx:else>
    <!-- 加载中 -->
    <wre-state
      wx:if="{{loading}}"
      type="loading"
      text="{{loadingText || '正在准备…'}}"
      sub="首次需要拉取你的划线原文，可能稍慢，请稍等"
    />

    <!-- Key 失效 -->
    <wre-state
      wx:elif="{{needsKey}}"
      type="error"
      text="{{error}}"
      action="去重新配置"
      actionType="settings"
      bind:action="onStateAction"
    />

    <!-- 其他错误 -->
    <wre-state
      wx:elif="{{error}}"
      type="error"
      text="{{error}}"
      action="重试"
      actionType="retry"
      bind:action="onStateAction"
    />

    <!-- 本期 / 往期内容 -->
    <block wx:elif="{{issue}}">
      <!-- 往期浏览提示条 -->
      <view class="archive-bar" wx:if="{{viewingArchive}}">
        <text class="archive-bar__text">正在看往期 · {{issue.weekLabel}}</text>
        <text class="archive-bar__back" bindtap="backToCurrent">回到本期</text>
      </view>

      <view class="wre-card card">
        <view class="card__date">{{issue.weekLabel}} · 灵感漫游</view>
        <view class="card__title">{{issue.title}}</view>
        <view class="card__themes">
          <text class="card__theme" wx:if="{{issue.theme}}">{{issue.theme}}</text>
          <text class="card__tier" wx:if="{{issue.tierName}}" bindtap="openRules">{{issue.tierName}} 档 · 规则说明 ›</text>
        </view>

        <!-- 摘要（本机规则排版；无摘要数据时不展示） -->
        <view class="summary" wx:if="{{issue.summary}}">{{issue.summary}}</view>

        <!-- 正文（下划线 = 你自己的划线 / 想法原文） -->
        <view class="note" wx:if="{{issue.body}}">
          <view class="note__text">
            <text wx:for="{{issue.bodySegs}}" wx:key="i" class="{{item.mine ? 'note__mine' : ''}}">{{item.text}}</text>
          </view>
        </view>

        <!-- 素材来源（可点开看全文）：本周主题下的划线 / 想法合辑 -->
        <view class="related" wx:if="{{issue.sources.length}}">
          <view class="related__title">素材来源（{{issue.sources.length}} 条）</view>
          <view class="related__item" wx:for="{{issue.sources}}" wx:key="index" data-index="{{index}}" bindtap="toggleSource">
            <view class="related__kind">{{item.kindLabel}}</view>
            <view class="related__text {{item.open ? '' : 'related__text--clamp'}}">{{item.text}}</view>
            <view class="related__from">——《{{item.title}}》{{item.author ? ' · ' + item.author : ''}}</view>
          </view>
        </view>

        <view class="ai-error" wx:if="{{aiError}}">{{aiError}}</view>
      </view>

      <!-- 操作 -->
      <view class="wre-card actions">
        <button class="wre-btn" bindtap="regenerate" loading="{{generating}}" disabled="{{generating}}">
          {{generating ? '正在重新排版…' : '重新生成'}}
        </button>
        <view class="actions-note">
          <text class="wre-muted">本周还可生成 {{weekLeft}} 次</text>
          <text class="rules-link" bindtap="openRules">漫游规则 ›</text>
        </view>
        <view class="actions-row">
          <button class="wre-btn wre-btn--ghost" bindtap="toggleStar">{{issue.starred ? '取消收藏' : '收藏这一期'}}</button>
          <button class="wre-btn wre-btn--ghost" bindtap="generateShare" loading="{{sharing}}" disabled="{{sharing}}">
            {{sharing ? '正在生成…' : '生成分享图'}}
          </button>
        </view>
      </view>

      <!-- 往期归档 + 随机漫游 -->
      <view class="wre-card" wx:if="{{history.length}}">
        <view class="history__head-row">
          <view class="wre-title">往期归档</view>
          <text class="history__roam" wx:if="{{canRoam}}" bindtap="roam">随机漫游</text>
        </view>
        <view class="history__item" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="viewArchive">
          <view class="history__head">
            <text class="history__date">{{item.weekLabel}}</text>
            <text class="history__star" wx:if="{{item.starred}}">★ 收藏</text>
          </view>
          <view class="history__title">{{item.title}}</view>
          <view class="history__theme" wx:if="{{item.theme}}">主题：{{item.theme}}{{item.tierName ? ' · ' + item.tierName + ' 档' : ''}}</view>
        </view>
      </view>

      <view class="wre-muted statement">每期只按主题把你自己的划线 / 想法编排在一起，全部在本机排版；归档与收藏只存本机，不上云。</view>
    </block>

    <!-- 未解锁：门槛进度引导 -->
    <view class="wre-card" wx:elif="{{!unlocked}}">
      <view class="wre-title">再读一点，就能开启灵感漫游</view>
      <view class="wre-muted">灵感漫游每周一次，从你的划线 / 想法里挑出同一主题的多条素材，编排成一组主题合辑。</view>
      <view class="progress-row">
        <text class="progress-k">划线</text>
        <text class="progress-v">{{marks}} / {{needMarks}} 条</text>
      </view>
      <view class="progress-row">
        <text class="progress-k">想法</text>
        <text class="progress-v">{{thoughts}} / {{needThoughts}} 条</text>
      </view>
      <view class="wre-muted" wx:if="{{gapMarks > 0 && gapThoughts > 0}}">还差 {{gapMarks}} 条划线、{{gapThoughts}} 条想法即可解锁。</view>
      <view class="wre-muted" wx:elif="{{gapMarks > 0}}">再积累 {{gapMarks}} 条划线即可解锁。</view>
      <view class="wre-muted" wx:elif="{{gapThoughts > 0}}">再写 {{gapThoughts}} 条想法即可解锁。</view>
      <button class="wre-btn" bindtap="retry">重新检查</button>
      <view class="rules-link rules-link--block" bindtap="openRules">看懂漫游规则 ›</view>
    </view>

    <!-- 素材不足：引导 -->
    <view class="wre-card" wx:elif="{{reason === 'material'}}">
      <view class="wre-title">素材还差一点点</view>
      <view class="wre-muted">灵感漫游需要同一主题下足够多的素材才好成组，当前的素材还不够组成一期合辑。</view>
      <view class="progress-row">
        <text class="progress-k">成组素材</text>
        <text class="progress-v">{{count}} / {{need}} 条</text>
      </view>
      <view class="wre-muted">去微信读书多划几段、写几句想法，再来看看。</view>
      <button class="wre-btn" bindtap="retry">重新检查</button>
      <view class="rules-link rules-link--block" bindtap="openRules">看懂漫游规则 ›</view>
    </view>

    <!-- 兜底：生成中 / 准备中 -->
    <wre-state
      wx:else
      type="loading"
      text="{{generating ? '正在编排本期主题合辑…' : '准备中…'}}"
      sub="{{generating ? '正在按主题把你的划线 / 想法编排在一起，稍等片刻' : ''}}"
    />
  </block>

  <!-- 分享图预览弹层 -->
  <view class="share-mask" wx:if="{{showShare}}" catchtouchmove="noop">
    <scroll-view class="share-preview" scroll-y>
      <image class="share-preview__img" src="{{shareImg}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    </scroll-view>
    <view class="share-actions">
      <button class="wre-btn" bindtap="shareImage">转发给朋友</button>
      <button class="wre-btn wre-btn--ghost" bindtap="saveShare">保存到相册</button>
      <button class="wre-btn wre-btn--ghost" bindtap="closeShare">关闭</button>
    </view>
  </view>

  <!-- 漫游规则说明弹层 -->
  <view class="rules-mask" wx:if="{{showRules}}" catchtouchmove="noop">
    <view class="rules-panel">
      <scroll-view class="rules-scroll" scroll-y>
        <view class="rules-title">漫游规则</view>

        <view class="rules-sec">
          <view class="rules-h">每周怎么生成</view>
          <view class="rules-p">每周按你的档位可生成 1～3 篇；点「重新生成」也计入本周次数，用完就要等下一周。</view>
        </view>

        <view class="rules-sec">
          <view class="rules-h">三档门槛（划线 / 想法条数）</view>
          <view class="rules-table">
            <view class="rules-row rules-row--head">
              <text class="rules-c1">档位</text>
              <text class="rules-c2">划线 / 想法</text>
              <text class="rules-c3">每周</text>
              <text class="rules-c4">素材</text>
            </view>
            <view class="rules-row {{item.key === myTier ? 'rules-row--on' : ''}}" wx:for="{{tiers}}" wx:key="key">
              <text class="rules-c1">{{item.name}}</text>
              <text class="rules-c2">≥{{item.marks}} / ≥{{item.thoughts}}</text>
              <text class="rules-c3">{{item.weekly}} 篇</text>
              <text class="rules-c4">最多 {{materialMax}} 条</text>
            </view>
          </view>
          <view class="rules-p">累积到 {{unlock.marks}} 条划线 + {{unlock.thoughts}} 条想法即解锁；不够时页面会显示还差多少。</view>
        </view>

        <view class="rules-sec">
          <view class="rules-h">素材怎么选</view>
          <view class="rules-p">只从你自己的划线 / 想法里挑：优先同一主题、尽量跨书铺开、同一素材尽量不重复出现。</view>
        </view>

        <view class="rules-sec">
          <view class="rules-h">怎么读</view>
          <view class="rules-p">每期就是一组合辑：按主题把你自己的划线 / 想法排在一起，点开每条可看全文与出处。</view>
        </view>
      </scroll-view>
      <button class="wre-btn" bindtap="closeRules">我知道了</button>
    </view>
  </view>
</view>
