.settings-status {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8A8F99;
}

.settings-status--ok {
  color: #12A150;
}

.settings-status--error {
  color: #E54545;
}

.settings-mask {
  color: #1F2430;
  font-weight: 600;
}

.settings-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.settings-help {
  color: #8A8F99;
  font-size: 26rpx;
  line-height: 1.9;
}
