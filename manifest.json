{
  "manifest_version": 3,
  "name": "微信悦读",
  "version": "0.14.1",
  "description": "增强微信读书网页版阅读体验：屏占比调节、主题切换、自动阅读、快捷键操作、勿扰模式、全屏模式、阅读统计、笔记导出与官方数据阅读行为分析（含 DeepSeek AI 人格化解读，可选）。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://i.weread.qq.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://weread.qq.com/*"
      ],
      "css": [
        "content.css",
        "modules/stats.css",
        "modules/notes.css",
        "modules/official.css"
      ],
      "js": [
        "modules/stats.js",
        "modules/notes.js",
        "modules/official.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
