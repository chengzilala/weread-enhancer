.settings-status {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: #8A8F99;
}

.settings-status--ok {
  color: #12A150;
}

.settings-status--error {
  color: #E54545;
}

.settings-mask {
  color: #1F2430;
  font-weight: 600;
}

.settings-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

.settings-help {
  color: #8A8F99;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
}

.settings-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.settings-link__label {
  font-size: calc(30rpx * var(--wre-fs));
  color: #1F2430;
}

/* 运营入口：标题 + 说明两行，箭头右侧对齐 */
.settings-link__main {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 16rpx;
}

.settings-link__desc {
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: #8A8F99;
}

.settings-link__arrow {
  color: #C0C4CC;
  font-size: calc(36rpx * var(--wre-fs));
}

/* 文字大小（四档切换，对齐 H5 .wre-modes / .wre-mode） */
.fs-modes {
  display: flex;
  background: #F5F6F8;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-top: 20rpx;
}

.fs-mode {
  flex: 1;
  text-align: center;
  color: #8A8F99;
  border-radius: 8rpx;
  padding: 14rpx 0;
  font-size: calc(28rpx * var(--wre-fs));
}

.fs-mode.is-active {
  background: #2F6BFF;
  color: #FFFFFF;
  font-weight: 600;
}

/* 我的资料 */
.profile-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.profile-avatar-btn {
  padding: 0;
  margin: 0;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 60rpx;
  overflow: hidden;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  display: block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F6F8;
  color: #A8ADB8;
  font-size: calc(26rpx * var(--wre-fs));
}

.profile-nick {
  flex: 1;
  margin-left: 28rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

/* 保存 / 清除 一行 */
.settings-actions {
  display: flex;
  margin-top: 24rpx;
}

.settings-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.settings-actions .wre-btn:last-child {
  margin-right: 0;
}

/* 参数详情（默认收起，点标题展开） */
.settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings-toggle__label {
  font-size: calc(34rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
}

.settings-toggle__action {
  font-size: calc(26rpx * var(--wre-fs));
  color: #2F6BFF;
}

.params {
  margin-top: 20rpx;
  border-top: 1rpx solid #F0F1F4;
}

.params__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.params__row:last-child {
  border-bottom: none;
}

.params__label {
  flex-shrink: 0;
  margin-right: 24rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: #8A8F99;
}

.params__value {
  flex: 1;
  text-align: right;
  font-size: calc(26rpx * var(--wre-fs));
  color: #1F2430;
  word-break: break-all;
}

.params__note {
  margin-top: 16rpx;
}
