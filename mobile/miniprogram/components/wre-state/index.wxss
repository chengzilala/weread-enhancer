/* 组件自身节点占满一行 */
:host {
  display: block;
}

.wre-state-root {
  display: block;
}

.wre-state {
  background: var(--wre-card);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

/* 空态 / 错误 / 无 Key：居中留白 */
.wre-state--plain {
  text-align: center;
  padding: 140rpx 48rpx;
}

.wre-state__text {
  color: var(--wre-muted);
  font-size: calc(28rpx * var(--wre-fs));
  line-height: 1.9;
}

.wre-state__sub {
  color: var(--wre-muted);
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
  margin-top: 8rpx;
}

/* 骨架屏：微光扫过 */
.wre-sk__block {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, var(--wre-fill) 25%, var(--wre-card-2) 37%, var(--wre-fill) 63%);
  background-size: 400% 100%;
  animation: wre-sk 1.2s ease infinite;
}

.wre-sk__block--lg {
  height: 72rpx;
}

.wre-sk__row {
  display: flex;
  justify-content: space-between;
}

.wre-sk__block--half {
  width: 48%;
}

@keyframes wre-sk {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
