/* 每日卡片回顾页 */

.card__date {
  font-size: 26rpx;
  color: #8A8F99;
  letter-spacing: 2rpx;
}

.card__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2430;
  line-height: 1.5;
  margin: 16rpx 0 12rpx;
}

.card__themes {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.card__theme {
  background: #F0F4FF;
  color: #2F6BFF;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 引用（划线原文 + 出处） */
.quote {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-left: 8rpx solid #2F6BFF;
  border-radius: 0 12rpx 12rpx 0;
}

.quote__text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #1F2430;
}

.quote__from {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 14rpx;
  text-align: right;
}

/* 说明 */
.note {
  margin-top: 28rpx;
}

.note__badge {
  display: inline-block;
  background: #2F6BFF;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-bottom: 14rpx;
}

.note__badge--local {
  background: #8A8F99;
}

.note__text {
  font-size: 30rpx;
  line-height: 1.9;
  color: #2A2F3A;
  white-space: pre-wrap;
}

/* 本地模板：说明「为什么这里没有解读」 */
.note__hint {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6B7280;
}

/* 关联的旧划线 */
.related {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F4;
}

.related__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 12rpx;
}

.related__item {
  padding: 16rpx 0 16rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid #F5F6F8;
}

.related__item:last-child {
  border-bottom: none;
}

.related__item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2F6BFF;
}

.related__text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4A5060;
}

.related__text--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.related__from {
  font-size: 24rpx;
  color: #A8ADB8;
  margin-top: 8rpx;
  text-align: right;
}

.ai-error {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #E54545;
  line-height: 1.6;
}

/* 操作区 */
.actions {
  text-align: center;
}

.actions .wre-muted {
  margin-top: 6rpx;
}

/* 收藏 / 生成分享图 一行 */
.actions-row {
  display: flex;
  margin-top: 24rpx;
}

.actions-row .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.actions-row .wre-btn:last-child {
  margin-right: 0;
}

/* 往期回看 */
.history__item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.history__item:last-child {
  border-bottom: none;
}

.history__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history__date {
  font-size: 24rpx;
  color: #8A8F99;
}

.history__star {
  font-size: 22rpx;
  color: #2F6BFF;
}

.history__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2430;
  margin: 8rpx 0;
}

.history__quote {
  font-size: 26rpx;
  color: #8A8F99;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 素材不足进度 */
.progress-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  margin: 16rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.progress-k {
  color: #8A8F99;
  font-size: 27rpx;
}

.progress-v {
  color: #1F2430;
  font-size: 27rpx;
  font-weight: 600;
}

/* 声明 */
.statement {
  padding: 8rpx 8rpx 24rpx;
  font-size: 24rpx;
}

/* 离屏绘制画布（不参与显示；实际绘制缓冲由 daily-share.js 按高清倍率设置） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}
