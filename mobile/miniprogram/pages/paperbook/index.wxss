/* 我的纸书 */

.pb-stat {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pb-hint {
  margin-bottom: 8rpx;
}

/* 搜索框 */
.pb-search {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  width: 100%;
}

.pb-search-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.pb-search--inline {
  flex: 1;
  margin-bottom: 0;
  margin-right: 16rpx;
}

.pb-search-btn {
  background: #2F6BFF;
  color: #FFFFFF;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1;
  height: 76rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pb-search-btn::after {
  border: none;
}

/* 列表 */
.pb-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.pb-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F4;
}

.pb-item:last-child {
  border-bottom: none;
}

.pb-cover {
  width: 108rpx;
  height: 148rpx;
  border-radius: 8rpx;
  background: #F0F1F4;
  flex-shrink: 0;
}

.pb-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #B6BAC3;
  font-size: 30rpx;
}

.pb-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.pb-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.pb-author {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

.pb-isbn,
.pb-reading {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 6rpx;
}

.pb-tags {
  margin-top: 10rpx;
}

.pb-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #8A8F99;
  background: #F0F1F4;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.pb-tag--on {
  color: #2F6BFF;
  background: #EAF1FF;
}

.pb-arrow {
  color: #C4C8D0;
  font-size: 40rpx;
  margin-left: 12rpx;
}

/* 表单 */
.pb-field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.pb-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.pb-input {
  flex: 1;
  font-size: 28rpx;
}

/* 关联 */
.pb-link {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.pb-link-title {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.pb-inline {
  display: flex;
  margin-top: 20rpx;
}

.pb-flex1 {
  flex: 1;
  margin-top: 0;
}

.pb-flex1 + .pb-flex1 {
  margin-left: 20rpx;
}

.pb-error {
  color: #E5484D;
  font-size: 28rpx;
}

/* 微信读书笔记 */
.pb-notes {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F1F4;
}

.pb-note-line {
  font-size: 28rpx;
  font-weight: 600;
}

.pb-note-sub {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 6rpx;
}

.pb-note-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.pb-note-item:last-child {
  border-bottom: none;
}

.pb-note-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2B2F36;
}

/* 底部 */
.pb-foot {
  margin-top: 8rpx;
}

.wre-btn--danger {
  background: #FFFFFF;
  color: #E5484D;
  border: 1rpx solid #E5484D;
}
