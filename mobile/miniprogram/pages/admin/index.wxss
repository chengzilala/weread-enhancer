/* 运营看板（M13）：刷新条 + 统计卡 + 版本分布 */

.admin-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.admin-bar__text {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.admin-bar__action {
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-brand);
}

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.card-metric {
  width: 48%;
  box-sizing: border-box;
  background: var(--wre-brand-soft);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.card-metric__value {
  font-size: calc(38rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-brand);
}

.card-metric__label {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  margin-top: 8rpx;
}

.versions {
  margin-top: 8rpx;
}

.versions__title {
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-text);
  margin-bottom: 8rpx;
}

.versions__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
}

.versions__row:last-child {
  border-bottom: none;
}

.versions__ver {
  font-size: calc(28rpx * var(--wre-fs));
  color: var(--wre-text);
}

.versions__count {
  font-size: calc(28rpx * var(--wre-fs));
  color: var(--wre-brand);
  font-weight: 600;
}

.admin-foot {
  padding: 0 8rpx 24rpx;
}
