/* 书架：概览 + 分类 + 电子书 / 专辑列表 */

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-metric {
  width: 48%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.card-metric__value {
  font-size: 38rpx;
  font-weight: 700;
  color: #2F6BFF;
}

.card-metric__label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #F0F4FF;
  color: #2F6BFF;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

/* 官方分组分区（只读，中性灰，与品牌蓝的标签区分） */
.wre-group {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F1F4;
}

.wre-group__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.wre-group__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2430;
}

.wre-group__count {
  font-size: 22rpx;
  color: #8A8F99;
  flex: none;
}

/* 组内书目：3 列封面网格（封面下写书名，仿官方书架） */
.wre-covergrid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.wre-covercell {
  width: 33.333%;
  padding: 8rpx;
  box-sizing: border-box;
}

.wre-covercell__img {
  display: block;
  width: 100%;
  height: 210rpx;
  border-radius: 10rpx;
  background: #F0F1F4;
}

.wre-covercell__title {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #1F2430;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.item:last-child {
  border-bottom: none;
}

.item__cover {
  width: 88rpx;
  height: 118rpx;
  border-radius: 10rpx;
  background: #F0F1F4;
  flex-shrink: 0;
}

.item__main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item__title {
  font-size: 30rpx;
  color: #1F2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__sub {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: #8A8F99;
  background: #F5F6F8;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-bottom: 6rpx;
}

.tag--done {
  color: #2F6BFF;
  background: #F0F4FF;
}

.more {
  text-align: center;
  margin-top: 16rpx;
}

/* 生成竖版分享图入口 */
.share-entry {
  text-align: center;
}

.share-entry .wre-muted {
  margin-top: 4rpx;
}

/* 离屏绘制画布（尺寸需与 shelf-share.js 中的画布缓冲一致：1080×3200） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}
