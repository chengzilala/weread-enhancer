.link-loading {
  margin-top: 20rpx;
}

/* 扫一扫：主操作，置于手动输入之上 */
.link-scan {
  margin-top: 24rpx;
}

/* 分区小标题（情况一 / 情况二） */
.link-sec {
  margin-top: 32rpx;
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
}

/* 我的账户码 */
.link-code {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--wre-soft);
  border-radius: 12rpx;
  font-size: calc(30rpx * var(--wre-fs));
  letter-spacing: 1rpx;
  color: var(--wre-text);
  word-break: break-all;
}

.link-code__ops {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}

.link-code__op {
  font-size: calc(28rpx * var(--wre-fs));
  color: var(--wre-tag-fg);
}

.link-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--wre-soft);
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

.link-hint {
  margin-top: 20rpx;
}

.link-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--wre-line);
  border-bottom: 1rpx solid var(--wre-line);
}

.link-state__label {
  font-size: calc(30rpx * var(--wre-fs));
  color: var(--wre-text);
}

.link-state__val {
  font-size: calc(28rpx * var(--wre-fs));
  color: var(--wre-tag-fg);
}

.link-status {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.link-status--ok {
  color: var(--wre-tag-fg);
}

.link-status--error {
  color: var(--wre-danger);
}

.wre-help {
  color: var(--wre-muted);
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
}
