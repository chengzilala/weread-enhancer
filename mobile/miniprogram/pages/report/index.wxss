/* 阅读报告页 */

.cache-hint {
  text-align: center;
  margin-bottom: 8rpx;
}

/* 周期切换 */
.period {
  display: flex;
  background: var(--wre-card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.period__item {
  flex: 1;
  text-align: center;
  line-height: calc(68rpx * var(--wre-fs));
  font-size: calc(28rpx * var(--wre-fs));
  color: var(--wre-muted);
  border-radius: 12rpx;
}

.period__item--active {
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-weight: 600;
}

/* 元素信息卡 */
.meta__row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}

.meta__k {
  color: var(--wre-muted);
  font-size: calc(26rpx * var(--wre-fs));
}

.meta__v {
  color: var(--wre-text);
  font-size: calc(26rpx * var(--wre-fs));
  max-width: 60%;
  text-align: right;
}

/* 章节标题 */
.sec-title {
  font-size: calc(32rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-text);
  margin: 28rpx 8rpx 16rpx;
}

.sec-title--sub {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text-3);
  margin: 20rpx 8rpx 12rpx;
}

/* 键值表 */
.kv__row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.kv__k {
  color: var(--wre-muted);
  font-size: calc(27rpx * var(--wre-fs));
}

.kv__v {
  color: var(--wre-text);
  font-size: calc(27rpx * var(--wre-fs));
  font-weight: 500;
  max-width: 60%;
  text-align: right;
}

/* 指标卡片 */
.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cards__item {
  width: 48%;
  box-sizing: border-box;
  background: var(--wre-card);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.cards__value {
  font-size: calc(36rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-brand);
}

.cards__label {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-text);
  margin-top: 8rpx;
}

/* 表格 */
.table-card {
  padding: 20rpx 24rpx;
}

.tbl__row {
  display: flex;
  position: relative;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
}

.tbl__row--head .tbl__cell {
  color: var(--wre-muted);
  font-size: calc(24rpx * var(--wre-fs));
  font-weight: 600;
}

.tbl__cell {
  flex: 1;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-text);
  word-break: break-all;
}

.tbl__bar {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 4rpx;
  background: var(--wre-brand);
  opacity: 0.9;
  border-radius: 4rpx;
}

/* 官方概要标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: var(--wre-brand-soft);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip__label {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  margin-right: 12rpx;
}

.chip__value {
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-brand);
  font-weight: 600;
}

/* 段落 */
.para {
  font-size: calc(28rpx * var(--wre-fs));
  line-height: 1.8;
  color: var(--wre-text-body);
}

/* 列表 */
.list__item {
  display: flex;
  padding: 8rpx 0;
}

.list__mark {
  color: var(--wre-brand);
  font-size: calc(26rpx * var(--wre-fs));
  margin-right: 12rpx;
  min-width: 32rpx;
}

.list__text {
  flex: 1;
  font-size: calc(27rpx * var(--wre-fs));
  line-height: 1.8;
  color: var(--wre-text-body);
}

/* 提示 / 空态 */
.note {
  padding: 8rpx 8rpx 16rpx;
}

/* 生成竖版分享图入口 */
.share-entry {
  text-align: center;
}

.share-entry .wre-muted {
  margin-top: 4rpx;
}

/* 离屏绘制画布（尺寸需与 report-share.js 中的画布缓冲一致：1080×3200） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}
