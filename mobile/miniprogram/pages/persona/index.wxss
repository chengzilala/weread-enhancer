/* 阅读人格页（结构对齐插件 wre-off-persona） */

/* 人格主卡头部：代码 + 称号 + 定调 + 代表人物插画 */
.persona__head {
  display: flex;
  align-items: center;
}

.persona__code {
  flex: 0 0 auto;
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-size: calc(32rpx * var(--wre-fs));
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
}

.persona__titlewrap {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.persona__name {
  font-size: calc(34rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-text);
}

.persona__tagline {
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  line-height: 1.5;
}

.persona__figurewrap {
  flex: 0 0 auto;
  width: 160rpx;
  text-align: center;
}

.persona__figure {
  display: block;
  width: 160rpx;
  height: 160rpx;
}

.persona__figurename {
  margin-top: 4rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.2;
  color: var(--wre-muted);
}

/* 代码释义 chips */
.hero__legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero__legend-item {
  display: flex;
  align-items: center;
  background: var(--wre-brand-soft);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}

.hero__legend-letter {
  font-size: calc(26rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-brand);
  margin-right: 8rpx;
}

.hero__legend-label {
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-text-3);
}

/* 生成竖版分享图 */
.persona__share {
  margin-top: 24rpx;
}

.persona__share-hint {
  margin-top: 8rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  text-align: center;
}

/* 三个特质绰号 */
.persona__nicks {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.persona__nick {
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--wre-brand);
  border-radius: 999rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-brand);
  margin: 0 12rpx 12rpx 0;
}

/* 一句话画像 */
.persona__oneliner {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--wre-brand);
  border-radius: 0 16rpx 16rpx 0;
  background: var(--wre-brand-soft);
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.8;
  color: var(--wre-text-body);
}

.persona__subtitle {
  margin: 24rpx 0 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
}

.persona__evidence {
  margin-top: 8rpx;
}

.persona__note {
  margin-top: 12rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.7;
  color: var(--wre-muted);
}

.persona__boundary {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--wre-line);
  font-size: calc(22rpx * var(--wre-fs));
  line-height: 1.6;
  color: var(--wre-muted);
}

/* 标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.chip {
  background: var(--wre-brand-soft);
  color: var(--wre-brand);
  font-size: calc(26rpx * var(--wre-fs));
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

/* 单维进度条 */
.persona__dims {
  margin-top: 8rpx;
}

.dim {
  margin-top: 20rpx;
}

.dim__top {
  display: flex;
  justify-content: space-between;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-text-3);
}

.dim__end.is-pick {
  color: var(--wre-brand);
  font-weight: 600;
}

.dim__pct {
  color: var(--wre-muted);
}

.dim__track {
  position: relative;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: var(--wre-fill);
  overflow: hidden;
}

.dim__track.is-center {
  background: linear-gradient(90deg, var(--wre-fill) 0%, var(--wre-brand) 50%, var(--wre-fill) 100%);
  opacity: 0.5;
}

.dim__track.is-na {
  background: repeating-linear-gradient(45deg, var(--wre-fill), var(--wre-fill) 8rpx, var(--wre-card-2) 8rpx, var(--wre-card-2) 16rpx);
}

.dim__fill {
  height: 100%;
  background: var(--wre-brand);
  border-radius: 999rpx;
}

.dim__basis {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--wre-fs));
  color: var(--wre-muted);
  line-height: 1.6;
}

/* 原文引用 */
.quote {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-left: 4rpx solid var(--wre-brand);
  border-radius: 0 16rpx 16rpx 0;
  background: var(--wre-card-2);
}

.quote__text {
  font-size: calc(27rpx * var(--wre-fs));
  line-height: 1.8;
  color: var(--wre-text-body);
}

.quote__src {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  margin-top: 8rpx;
}

/* 词语分析 */
.persona__words {
  margin-top: 8rpx;
}

.words__label {
  margin: 20rpx 0 12rpx;
  font-size: calc(26rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
}

.word-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.word-rank {
  flex: 0 0 40rpx;
  text-align: center;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.word {
  flex: 0 0 auto;
  min-width: 90rpx;
  font-size: calc(26rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
}

.word-bar {
  flex: 1 1 auto;
  height: 12rpx;
  margin: 0 12rpx;
  border-radius: 999rpx;
  background: var(--wre-fill);
  overflow: hidden;
}

.word-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--wre-brand);
}

.word-count {
  flex: 0 0 60rpx;
  text-align: right;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.emotion-bar {
  display: flex;
  height: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--wre-fill);
}

.emotion-bar__seg {
  height: 100%;
}

.emotion-bar__seg.is-pos {
  background: var(--wre-pos);
}

.emotion-bar__seg.is-neu {
  background: var(--wre-neu);
}

.emotion-bar__seg.is-neg {
  background: var(--wre-neg);
}

.emotion-legend {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.cloud {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--wre-line);
  border-radius: 16rpx;
  background: var(--wre-card-2);
}

.cloud__word {
  line-height: 1.4;
  color: var(--wre-brand);
  margin-right: 20rpx;
}

.words__catch {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-text-body);
}

.words__catch-em {
  color: var(--wre-brand);
  font-weight: 600;
}

.words__catch-src {
  color: var(--wre-muted);
  font-size: calc(24rpx * var(--wre-fs));
}

/* 数据不足进度 */
.progress-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
}

.progress-k {
  color: var(--wre-muted);
  font-size: calc(27rpx * var(--wre-fs));
}

.progress-v {
  color: var(--wre-text);
  font-size: calc(27rpx * var(--wre-fs));
  font-weight: 600;
}

/* 声明 */
.statement {
  padding: 8rpx 8rpx 24rpx;
  font-size: calc(24rpx * var(--wre-fs));
}

/* 离屏绘制画布（不参与显示；实际绘制缓冲由 persona-share.js 按高清倍率设置） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}
