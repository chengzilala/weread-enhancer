/* 微信悦读 · 移动端全局样式（品牌色与插件 / 官网一致） */
page {
  background: #F5F6F8;
  color: #1F2430;
  font-size: calc(28rpx * var(--wre-fs));
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
  /* 全局文字缩放系数（小 0.9 / 标准 1 / 大 1.15 / 特大 1.3）；
     由页面根节点内联 style 覆盖，见「我的 → 文字大小」 */
  --wre-fs: 1;
}

.wre-page {
  padding: 24rpx;
  box-sizing: border-box;
}

.wre-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.wre-title {
  font-size: calc(34rpx * var(--wre-fs));
  font-weight: 600;
  margin-bottom: 16rpx;
}

.wre-muted {
  color: #8A8F99;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
}

.wre-big {
  font-size: calc(64rpx * var(--wre-fs));
  font-weight: 700;
  color: #2F6BFF;
}

/* 按钮 */
.wre-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2F6BFF;
  color: #FFFFFF;
  border-radius: 14rpx;
  font-size: calc(30rpx * var(--wre-fs));
  line-height: 1;
  height: 88rpx;
  margin-top: 24rpx;
}

.wre-btn::after {
  border: none;
}

.wre-btn--ghost {
  background: #FFFFFF;
  color: #2F6BFF;
  border: 1rpx solid #2F6BFF;
}
