/* 灵感漫游页（M12）：每周一篇多素材编织的主题综述 */

.card__date {
  font-size: calc(26rpx * var(--wre-fs));
  color: #8A8F99;
  letter-spacing: 2rpx;
}

.card__title {
  font-size: calc(44rpx * var(--wre-fs));
  font-weight: 700;
  color: #1F2430;
  line-height: 1.5;
  margin: 16rpx 0 12rpx;
}

.card__themes {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.card__theme {
  background: #F1EDFF;
  color: #7C5CFF;
  font-size: calc(24rpx * var(--wre-fs));
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 档位 + 规则说明入口（可点开弹层） */
.card__tier {
  background: #E8E3FF;
  color: #4A3F80;
  font-size: calc(24rpx * var(--wre-fs));
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 摘要（浅底卡） */
.summary {
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  background: #F1EDFF;
  border-radius: 16rpx;
  font-size: calc(30rpx * var(--wre-fs));
  line-height: 1.8;
  color: #4A3F80;
  white-space: pre-wrap;
}

/* 正文说明 */
.note {
  margin-top: 28rpx;
}

.note__badge {
  display: inline-block;
  background: #7C5CFF;
  color: #FFFFFF;
  font-size: calc(22rpx * var(--wre-fs));
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-bottom: 14rpx;
}

.note__text {
  font-size: calc(30rpx * var(--wre-fs));
  line-height: 1.9;
  color: #2A2F3A;
  white-space: pre-wrap;
}

/* 下划线 = 你自己划下 / 写下的原文（由 AI 用 [[ ]] 标出，前端切段渲染） */
.note__mine {
  text-decoration: underline;
  text-decoration-color: #7C5CFF;
}

/* 素材来源（可点开） */
.related {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F4;
}

.related__title {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 12rpx;
}

.related__item {
  padding: 16rpx 0 16rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid #F5F6F8;
}

.related__item:last-child {
  border-bottom: none;
}

.related__item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7C5CFF;
}

.related__kind {
  display: inline-block;
  font-size: calc(22rpx * var(--wre-fs));
  color: #7C5CFF;
  background: #F1EDFF;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-bottom: 8rpx;
}

.related__text {
  font-size: calc(28rpx * var(--wre-fs));
  line-height: 1.8;
  color: #4A5060;
}

.related__text--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.related__from {
  font-size: calc(24rpx * var(--wre-fs));
  color: #A8ADB8;
  margin-top: 8rpx;
  text-align: right;
}

/* 外部火花 */
.sparks {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F4;
}

.sparks__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sparks__title {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
}

.sparks__badge {
  font-size: calc(20rpx * var(--wre-fs));
  color: #92700B;
  background: #FFF6DE;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.sparks__item {
  display: flex;
  padding: 10rpx 0;
}

.sparks__dot {
  color: #7C5CFF;
  font-size: calc(30rpx * var(--wre-fs));
  line-height: 1.7;
  margin-right: 10rpx;
}

.sparks__text {
  flex: 1;
  font-size: calc(28rpx * var(--wre-fs));
  line-height: 1.7;
  color: #4A5060;
}

/* 火花的出处（可为空；有出处时附在句末，小字、灰金） */
.sparks__source {
  font-size: calc(22rpx * var(--wre-fs));
  color: #92700B;
}

/* 创作种子 */
.seeds {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F4;
}

.seeds__title {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 12rpx;
}

.seeds__item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.seeds__item:last-child {
  border-bottom: none;
}

.seeds__angle {
  display: inline-block;
  font-size: calc(22rpx * var(--wre-fs));
  color: #FFFFFF;
  background: #7C5CFF;
  border-radius: 8rpx;
  padding: 2rpx 14rpx;
  margin-bottom: 8rpx;
}

.seeds__line {
  font-size: calc(28rpx * var(--wre-fs));
  line-height: 1.8;
  color: #2A2F3A;
}

.ai-error {
  margin-top: 20rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: #E54545;
  line-height: 1.6;
}

/* 往期浏览提示条 */
.archive-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F1EDFF;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.archive-bar__text {
  font-size: calc(26rpx * var(--wre-fs));
  color: #4A3F80;
}

.archive-bar__back {
  font-size: calc(26rpx * var(--wre-fs));
  font-weight: 600;
  color: #7C5CFF;
}

/* 操作区 */
.actions {
  text-align: center;
}

.actions .wre-muted {
  margin-top: 6rpx;
}

.actions-row {
  display: flex;
  margin-top: 24rpx;
}

.actions-row .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.actions-row .wre-btn:last-child {
  margin-right: 0;
}

/* 往期归档 */
.history__head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history__roam {
  font-size: calc(26rpx * var(--wre-fs));
  font-weight: 600;
  color: #7C5CFF;
}

.history__item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.history__item:last-child {
  border-bottom: none;
}

.history__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history__date {
  font-size: calc(24rpx * var(--wre-fs));
  color: #8A8F99;
}

.history__star {
  font-size: calc(22rpx * var(--wre-fs));
  color: #7C5CFF;
}

.history__title {
  font-size: calc(30rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
  margin: 8rpx 0 4rpx;
}

.history__theme {
  font-size: calc(24rpx * var(--wre-fs));
  color: #8A8F99;
}

/* 门槛 / 素材进度 */
.progress-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.progress-k {
  color: #8A8F99;
  font-size: calc(27rpx * var(--wre-fs));
}

.progress-v {
  color: #1F2430;
  font-size: calc(27rpx * var(--wre-fs));
  font-weight: 600;
}

.wre-card .wre-btn {
  margin-top: 20rpx;
}

/* 声明 */
.statement {
  padding: 8rpx 8rpx 24rpx;
  font-size: calc(24rpx * var(--wre-fs));
}

/* 离屏绘制画布（不参与显示；实际绘制缓冲由 wander-share.js 按高清倍率设置） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}

/* 操作区底部一行：本周剩余次数 + 规则入口 */
.actions-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}

.actions-note .wre-muted {
  margin-top: 0;
}

/* 规则说明入口（文字链） */
.rules-link {
  font-size: calc(26rpx * var(--wre-fs));
  color: #7C5CFF;
  margin-left: 16rpx;
}

.rules-link--block {
  display: block;
  text-align: center;
  margin: 24rpx 0 0;
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
}

/* 漫游规则说明弹层 */
.rules-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.6);
}

.rules-panel {
  width: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.rules-scroll {
  max-height: 60vh;
}

.rules-title {
  font-size: calc(34rpx * var(--wre-fs));
  font-weight: 700;
  color: #1F2430;
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.rules-sec {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.rules-sec:last-child {
  border-bottom: none;
}

.rules-h {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
  margin-bottom: 12rpx;
}

.rules-p {
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.8;
  color: #4A5060;
}

/* 三档门槛表 */
.rules-table {
  margin: 4rpx 0 14rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F7F8FA;
}

.rules-row {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #EDEEF2;
}

.rules-row:last-child {
  border-bottom: none;
}

.rules-row--head {
  background: #F1EDFF;
}

.rules-row--head .rules-c1,
.rules-row--head .rules-c2,
.rules-row--head .rules-c3,
.rules-row--head .rules-c4 {
  color: #4A3F80;
  font-weight: 600;
}

/* 当前档位高亮 */
.rules-row--on {
  background: #EDE8FF;
}

.rules-row--on .rules-c1 {
  color: #7C5CFF;
  font-weight: 700;
}

.rules-c1 {
  width: 110rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: #1F2430;
}

.rules-c2 {
  flex: 1.3;
  font-size: calc(24rpx * var(--wre-fs));
  color: #4A5060;
}

.rules-c3 {
  flex: 1;
  font-size: calc(24rpx * var(--wre-fs));
  color: #4A5060;
  text-align: center;
}

.rules-c4 {
  flex: 1.2;
  font-size: calc(24rpx * var(--wre-fs));
  color: #4A5060;
  text-align: right;
}

.rules-panel .wre-btn {
  margin-top: 24rpx;
}
