<view class="wre-page {{wreDark ? 'wre-dark' : ''}}" style="--wre-fs:{{wreFs}}">
  <!-- 分享图绘制画布（移出屏幕外，不可见） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

  <!-- 无 Key 引导：介绍页（对齐 H5 引导页） -->
  <wre-landing wx:if="{{!hasKey}}" bind:action="onStateAction" />

  <block wx:else>
    <!-- 加载中 -->
    <wre-state wx:if="{{loading}}" type="loading" text="正在读取你的书架…" />

    <!-- 错误 / 需重新配置 Key -->
    <wre-state
      wx:elif="{{error}}"
      type="error"
      text="{{error}}"
      action="{{needsKey ? '去配置 Key' : '重试'}}"
      actionType="{{needsKey ? 'settings' : 'retry'}}"
      bind:action="onStateAction"
    />

    <block wx:else>
      <!-- 概览 -->
      <view class="cards">
        <view class="card-metric" wx:for="{{cards}}" wx:key="label">
          <view class="card-metric__value">{{item.value}}</view>
          <view class="card-metric__label">{{item.label}}</view>
        </view>
      </view>

      <!-- 生成竖版分享图 -->
      <view class="wre-card share-entry" wx:if="{{total > 0}}">
        <button class="wre-btn" bindtap="generateShare" loading="{{sharing}}" disabled="{{sharing}}">
          {{sharing ? '正在生成…' : '生成书架分享图'}}
        </button>
        <view class="wre-muted">生成后可一键转发给微信好友，或保存到相册</view>
      </view>

      <!-- 分类分布 -->
      <view class="wre-card" wx:if="{{categories.length}}">
        <view class="wre-title">分类分布</view>
        <view class="chips">
          <view class="chip" wx:for="{{categories}}" wx:key="name">{{item.name}} · {{item.count}}</view>
        </view>
      </view>

      <!-- 按官方分组（只读，来自官方书架 archive）：组名 + 本数做成胶囊，一行多个 -->
      <view class="wre-card" wx:if="{{groups.length || ungrouped}}">
        <view class="wre-title">按官方分组</view>
        <view class="chips">
          <view class="chip" wx:for="{{groups}}" wx:key="name">{{item.name}} · {{item.count}} 本</view>
          <view class="chip" wx:if="{{ungrouped}}">未分组 · {{ungrouped.count}} 本</view>
        </view>
        <view class="more wre-muted">官方分组为只读数据，来自你的微信读书官方书架。</view>
      </view>

      <!-- 空书架 -->
      <wre-state
        wx:if="{{total === 0}}"
        type="empty"
        text="书架里暂时没有书"
      />

      <!-- 文章收藏提示 -->
      <view class="wre-card" wx:if="{{hasMp}}">
        <view class="wre-muted">书架另含「文章收藏」入口（不计入上方数量）。</view>
      </view>

      <view class="more wre-muted" wx:if="{{cacheHint}}">{{cacheHint}}</view>
    </block>
  </block>

  <!-- 分享图预览弹层 -->
  <view class="share-mask" wx:if="{{showShare}}" catchtouchmove="noop">
    <scroll-view class="share-preview" scroll-y>
      <image class="share-preview__img" src="{{shareImg}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    </scroll-view>
    <view class="share-actions">
      <button class="wre-btn" bindtap="shareImage">转发给朋友</button>
      <button class="wre-btn wre-btn--ghost" bindtap="copyLink">复制分享链接</button>
      <button class="wre-btn wre-btn--ghost" bindtap="saveShare">保存到相册</button>
      <button class="wre-btn wre-btn--ghost" bindtap="closeShare">关闭</button>
    </view>
  </view>
</view>
