<view class="wre-page {{wreDark ? 'wre-dark' : ''}}" style="--wre-fs:{{wreFs}}">
  <!-- 我的资料（可选）：仅本机 -->
  <view class="wre-card">
    <view class="wre-title">我的资料（可选）</view>
    <view class="wre-muted">只保存在本机，用于本页展示与分享图署名，不上传。</view>

    <view class="profile-row">
      <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-avatar profile-avatar--empty">头像</view>
      </button>
      <input
        class="profile-nick"
        type="nickname"
        placeholder="点击填写昵称"
        value="{{nickName}}"
        bindchange="onNickChange"
        bindblur="onNickChange"
      />
    </view>

    <button class="wre-btn wre-btn--ghost" wx:if="{{hasProfile}}" bindtap="onClearProfile">清除资料</button>
  </view>

  <!-- 文字大小（对齐 H5「我的 → 文字大小」） -->
  <view class="wre-card">
    <view class="wre-title">文字大小</view>
    <view class="wre-muted">调大后全站文字一起放大，方便在手机上看清；只存本机。</view>
    <view class="fs-modes">
      <view
        wx:for="{{fontTiers}}"
        wx:key="key"
        class="fs-mode {{item.value === wreFs ? 'is-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onFontScale"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 外观（对齐 H5「我的 → 外观」） -->
  <view class="wre-card">
    <view class="wre-title">外观</view>
    <view class="wre-muted">默认跟随系统明暗；也可手动固定为浅色或深色。只存本机。</view>
    <view class="theme-modes">
      <view
        wx:for="{{themeTiers}}"
        wx:key="key"
        class="theme-mode {{item.key === themePref ? 'is-active' : ''}}"
        data-value="{{item.key}}"
        bindtap="onTheme"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 微信读书 API Key -->
  <view class="wre-card">
    <view class="wre-title">API Key</view>
    <view class="wre-muted">Key 仅保存在本机；调用时经微信云函数中转访问官方接口，不存储、不记录。</view>

    <view class="settings-status" wx:if="{{hasKey}}">
      当前已配置：<text class="settings-mask">{{masked}}</text>
    </view>

    <input
      class="settings-input"
      type="text"
      password="{{true}}"
      placeholder="粘贴 wrk- 开头的 API Key"
      value="{{input}}"
      bindinput="onInput"
    />

    <view class="settings-actions">
      <button class="wre-btn" loading="{{saving}}" bindtap="onSave">保存并校验</button>
      <button class="wre-btn wre-btn--ghost" wx:if="{{hasKey}}" bindtap="onClear">清除 Key</button>
    </view>
    <view class="settings-status settings-status--{{statusType}}" wx:if="{{statusText}}">{{statusText}}</view>
  </view>

  <!-- M15 合规下线：原 Key 输入区块已移除 -->

  <!-- 相关入口：四端互联；小程序内无法直接打开网页，点击为「复制链接 + 弹窗提示」 -->
  <view class="wre-card">
    <view class="wre-title">相关入口</view>
    <view class="wre-muted">它们都是同一款「微信悦读」，分工不同。小程序里不能直接打开网页，点一下会复制链接，再到浏览器粘贴访问即可。</view>
    <view class="settings-link" bindtap="copySite">
      <view class="settings-link__main">
        <text class="settings-link__label">🌐 官网 · 插件下载与教程</text>
        <text class="settings-link__desc">电脑端插件的安装、使用教程都在这</text>
      </view>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" bindtap="copyH5">
      <view class="settings-link__main">
        <text class="settings-link__label">📱 H5 网页版 · 带 AI 深度解析</text>
        <text class="settings-link__desc">手机浏览器打开，复制链接后用浏览器访问</text>
      </view>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" bindtap="copyPersonal">
      <view class="settings-link__main">
        <text class="settings-link__label">👤 我的个人网站</text>
        <text class="settings-link__desc">作者的其他作品与文章</text>
      </view>
      <text class="settings-link__arrow">›</text>
    </view>
  </view>

  <view class="wre-card">
    <view class="wre-title">更多</view>
    <view class="settings-link" bindtap="goPaperbook">
      <text class="settings-link__label">📚 我的纸书</text>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" bindtap="goLink">
      <view class="settings-link__main">
        <text class="settings-link__label">🔗 关联网页账户</text>
        <text class="settings-link__desc">{{linked ? '已关联 · 与网页共用阅读人格与昵称' : '关联网页版后，两端共用阅读人格与昵称'}}</text>
      </view>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" bindtap="goNotes">
      <text class="settings-link__label">笔记概览</text>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" bindtap="goDaily">
      <text class="settings-link__label">每日卡片 · 往期回顾</text>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" bindtap="goWander">
      <text class="settings-link__label">灵感漫游 · 往期归档</text>
      <text class="settings-link__arrow">›</text>
    </view>
    <view class="settings-link" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <view class="settings-link__main">
        <text class="settings-link__label">📊 运营看板</text>
        <text class="settings-link__desc">小程序 / 插件使用量与我的阅读数据汇总 · 无需口令，按账号自动识别</text>
      </view>
      <text class="settings-link__arrow">›</text>
    </view>
  </view>

  <view class="wre-card">
    <view class="settings-toggle" bindtap="toggleParams">
      <text class="settings-toggle__label">参数详情</text>
      <text class="settings-toggle__action">{{showParams ? '收起 ▴' : '展开 ▾'}}</text>
    </view>
    <view wx:if="{{showParams}}" class="params">
      <view class="params__row" wx:for="{{params}}" wx:key="label">
        <text class="params__label">{{item.label}}</text>
        <text class="params__value">{{item.value}}</text>
      </view>
      <view class="params__row" wx:if="{{myOpenid}}">
        <text class="params__label">我的 openid</text>
        <text class="params__value">{{myOpenid}}</text>
      </view>
      <button class="wre-btn wre-btn--ghost" wx:if="{{myOpenid}}" bindtap="copyOpenid">复制 openid</button>
      <view class="wre-muted params__note">仅展示本机可见的配置项与掩码，不显示 Key 明文。</view>
      <view class="wre-muted params__note">openid 仅你自己可见；开启运营看板时，把它填进云函数环境变量 ADMIN_OPENIDS 即可。</view>
    </view>
  </view>

  <view class="wre-card">
    <view class="wre-title">说明</view>
    <view class="settings-help">1. 微信读书 API Key：在微信读书 App →「我」→「微信读书 Skill」页面复制（wrk- 开头）。</view>
    <view class="settings-help">2. Key 只存手机本地，卸载小程序或清理微信缓存后会丢失，需要重新填写。</view>
    <view class="settings-help">3. 清除 Key 后，首页 / 人格 / 报告 / 书架会回到引导状态。</view>
    <view class="settings-help">4. 头像昵称可选，仅存本机、不上传。</view>
    <view class="settings-help">5. 阅读报告、阅读人格、每日卡片、灵感漫游均为本机按固定规则计算与整理，结果只保存在本机（阅读人格可选择存到云端用于换机找回）。</view>
  </view>
</view>
