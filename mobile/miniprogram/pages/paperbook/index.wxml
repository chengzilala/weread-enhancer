<view class="wre-page">
  <!-- ========== 列表视图 ========== -->
  <block wx:if="{{view === 'list'}}">
    <view class="wre-card">
      <view class="pb-stat">共 {{books.length}} 本 · 已关联电子版 {{linkedCount}} 本</view>
      <view class="wre-muted pb-hint" wx:if="{{!hasKey}}">
        未配置 API Key：可以正常建档，但暂时不能自动补书名、也不能关联微信读书电子版。去「我的」页配置后即可。
      </view>
      <button class="wre-btn" bindtap="onScan">📷 扫码加书</button>
      <button class="wre-btn wre-btn--ghost" bindtap="onPhotoScan">🖼 拍照识码（旧书 / 条码磨损）</button>
      <button class="wre-btn wre-btn--ghost" bindtap="onAddManual">手动添加（无条码的旧书）</button>
    </view>

    <input
      class="pb-search"
      placeholder="搜索书名 / 作者 / ISBN / 标签"
      value="{{keyword}}"
      bindinput="onSearchInput"
    />

    <scroll-view class="pb-filters" scroll-x enable-flex>
      <view class="pb-chip {{filter === 'all' ? 'pb-chip--on' : ''}}" data-value="all" bindtap="onFilter">全部</view>
      <view class="pb-chip {{filter === 'linked' ? 'pb-chip--on' : ''}}" data-value="linked" bindtap="onFilter">有电子版</view>
      <view class="pb-chip {{filter === 'paper' ? 'pb-chip--on' : ''}}" data-value="paper" bindtap="onFilter">仅纸质</view>
      <view class="pb-chip {{filter === 'read' ? 'pb-chip--on' : ''}}" data-value="read" bindtap="onFilter">已读</view>
      <view class="pb-chip {{filter === 'reading' ? 'pb-chip--on' : ''}}" data-value="reading" bindtap="onFilter">在读</view>
      <view class="pb-chip {{filter === 'want' ? 'pb-chip--on' : ''}}" data-value="want" bindtap="onFilter">想读</view>
    </scroll-view>

    <wre-state
      wx:if="{{!books.length}}"
      type="empty"
      text="你的纸书库还是空的"
      sub="点上面「📷 扫码加书」，对准书背条码即可连续录入；旧书条码扫不出可「拍照识码」"
    />

    <block wx:else>
      <view class="pb-list">
        <view class="pb-item" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
          <image wx:if="{{item.cover}}" class="pb-cover" src="{{item.cover}}" mode="aspectFill" />
          <view wx:else class="pb-cover pb-cover--empty">书</view>
          <view class="pb-info">
            <view class="pb-title">{{item.title || '未命名纸书'}}</view>
            <view class="pb-author" wx:if="{{item.author}}">{{item.author}}</view>
            <view class="pb-isbn" wx:if="{{item.isbn}}">ISBN {{item.isbn}}</view>
            <view class="pb-tags">
              <text class="pb-tag pb-tag--on" wx:if="{{item.bookId}}">{{item.linkManual ? '手动关联电子版' : '有电子版'}}</text>
              <text class="pb-tag" wx:else>仅纸质</text>
              <text class="pb-tag pb-tag--status" wx:if="{{item.status}}">{{item.status === 'read' ? '已读' : (item.status === 'reading' ? '在读' : '想读')}}</text>
              <text class="pb-tag pb-tag--soft" wx:for="{{item.tags}}" wx:key="index">{{item}}</text>
            </view>
          </view>
          <text class="pb-arrow">›</text>
        </view>
      </view>

      <wre-state wx:if="{{!filtered.length}}" type="empty" text="没有匹配的书" sub="换个关键字试试" />

      <view class="pb-foot">
        <button class="wre-btn wre-btn--ghost" bindtap="onExport">导出 Markdown（分享文件）</button>
        <button class="wre-btn wre-btn--ghost" bindtap="onExportCopy">复制 Markdown 到剪贴板</button>
        <button class="wre-btn wre-btn--ghost" bindtap="onRestore">从云端恢复备份</button>
      </view>
    </block>
  </block>

  <!-- ========== 详情 / 编辑视图 ========== -->
  <block wx:elif="{{view === 'edit'}}">
    <view class="wre-card">
      <view class="wre-title">{{isNew ? '添加纸书' : '纸书详情'}}</view>
      <view class="pb-field">
        <text class="pb-label">书名</text>
        <input class="pb-input" placeholder="书名" value="{{editing.title}}" data-field="title" bindinput="onFieldInput" />
      </view>
      <view class="pb-field">
        <text class="pb-label">作者</text>
        <input class="pb-input" placeholder="作者（可选）" value="{{editing.author}}" data-field="author" bindinput="onFieldInput" />
      </view>
      <view class="pb-field">
        <text class="pb-label">ISBN</text>
        <input class="pb-input" placeholder="13 位条码数字（可选）" value="{{editing.isbn}}" data-field="isbn" bindinput="onFieldInput" />
      </view>
      <view class="pb-field pb-field--stack">
        <text class="pb-label">阅读状态</text>
        <view class="pb-chips">
          <view class="pb-chip {{editing.status === 'read' ? 'pb-chip--on' : ''}}" data-value="read" bindtap="onStatusPick">已读</view>
          <view class="pb-chip {{editing.status === 'reading' ? 'pb-chip--on' : ''}}" data-value="reading" bindtap="onStatusPick">在读</view>
          <view class="pb-chip {{editing.status === 'want' ? 'pb-chip--on' : ''}}" data-value="want" bindtap="onStatusPick">想读</view>
        </view>
      </view>
      <view class="pb-field pb-field--stack">
        <text class="pb-label">标签</text>
        <view class="pb-tag-edit" wx:if="{{editing.tags.length}}">
          <view class="pb-tag-chip" wx:for="{{editing.tags}}" wx:key="index" data-index="{{index}}" bindtap="onTagRemove">
            {{item}}<text class="pb-tag-x">✕</text>
          </view>
        </view>
        <view class="pb-search-row">
          <input class="pb-search pb-search--inline" placeholder="加标签，如 一号书柜 / 借出中" value="{{tagInput}}" bindinput="onTagInput" bindconfirm="onTagAdd" />
          <button class="pb-search-btn" bindtap="onTagAdd">加入</button>
        </view>
      </view>
      <view class="pb-field">
        <text class="pb-label">纸质位置</text>
        <input class="pb-input" placeholder="如 客厅书架第 2 层（可选）" value="{{editing.location}}" data-field="location" bindinput="onFieldInput" />
      </view>
      <view class="pb-field pb-field--stack">
        <text class="pb-label">我的感想</text>
        <textarea class="pb-textarea" placeholder="读完这本想说点什么（只存本机，与微信读书笔记分开）" value="{{editing.feeling}}" data-field="feeling" bindinput="onFieldInput" maxlength="2000" auto-height />
      </view>
      <button class="wre-btn" bindtap="onSave">保存</button>
    </view>

    <view class="wre-card" wx:if="{{!isNew}}">
      <view class="wre-title">微信读书</view>
      <block wx:if="{{editing.bookId}}">
        <view class="pb-link">
          <text class="pb-tag pb-tag--on">{{editing.linkManual ? '手动关联' : '自动匹配'}}</text>
          <text class="pb-link-title">{{editing.linkTitle || editing.title}}</text>
        </view>
        <button class="wre-btn" bindtap="onGoWeread">去微信读书读</button>

        <!-- M5：微信读书笔记 -->
        <view class="pb-notes">
          <view class="wre-muted" wx:if="{{noteLoading}}">正在读取笔记…</view>
          <block wx:elif="{{noteCounts && noteCounts.ok}}">
            <view wx:if="{{noteCounts.total}}">
              <view class="pb-note-line">微信读书笔记：{{noteCounts.total}} 条</view>
              <view class="pb-note-sub">划线 {{noteCounts.noteCount}} · 想法 {{noteCounts.reviewCount}} · 书签 {{noteCounts.bookmarkCount}}</view>
            </view>
            <view class="wre-muted" wx:else>微信读书里这本还没有笔记</view>
            <button class="wre-btn wre-btn--ghost" wx:if="{{noteCounts.total}}" bindtap="onOpenNotes">查看笔记明细</button>
          </block>
          <view class="wre-muted" wx:elif="{{noteCounts && !noteCounts.ok}}">{{noteCounts.error || '笔记读取失败'}}</view>
        </view>

        <view class="pb-inline">
          <button class="wre-btn wre-btn--ghost pb-flex1" bindtap="onLinkStart">换一本</button>
          <button class="wre-btn wre-btn--ghost pb-flex1" bindtap="onUnlink">解除关联</button>
        </view>
      </block>
      <block wx:else>
        <view class="wre-muted">这本还没关联微信读书电子版。{{hasKey ? '可以搜一搜，挑一本绑定。' : '配置 API Key 后可搜索关联。'}}</view>
        <button class="wre-btn" bindtap="onLinkStart">手动关联电子书</button>
      </block>
    </view>

    <view class="pb-foot">
      <button class="wre-btn wre-btn--ghost" bindtap="onBackToList">返回列表</button>
      <button class="wre-btn wre-btn--danger" wx:if="{{!isNew}}" bindtap="onDelete">删除这本</button>
    </view>
  </block>

  <!-- ========== 手动关联视图 ========== -->
  <block wx:elif="{{view === 'link'}}">
    <view class="wre-card">
      <view class="wre-title">手动关联电子书</view>
      <view class="wre-muted">搜微信读书，点一本绑定到「{{editing.title || editing.isbn}}」。</view>
      <view class="pb-search-row">
        <input
          class="pb-search pb-search--inline"
          placeholder="书名 / 作者"
          value="{{linkKeyword}}"
          bindinput="onLinkKeyword"
          bindconfirm="onLinkSearch"
        />
        <button class="pb-search-btn" bindtap="onLinkSearch">搜索</button>
      </view>
    </view>

    <wre-state wx:if="{{linkLoading}}" type="loading" text="正在搜微信读书…" />
    <view class="wre-card pb-error" wx:elif="{{linkError}}">{{linkError}}</view>

    <view class="wre-card" wx:if="{{!linkSearched && !linkLoading && !linkError}}">
      <view class="wre-muted">微信读书按「书名 / 作者」搜索（不认 ISBN）。搜索会先在你的微信读书书架里找，命中会置顶标「在我的书架」。</view>
    </view>

    <view class="wre-card" wx:if="{{!linkLoading && !linkError && linkResults.length}}">
      <view class="pb-item" wx:for="{{linkResults}}" wx:key="bookId" data-index="{{index}}" bindtap="onLinkPick">
        <image wx:if="{{item.cover}}" class="pb-cover" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="pb-cover pb-cover--empty">书</view>
        <view class="pb-info">
          <view class="pb-title">{{item.title}}</view>
          <view class="pb-author" wx:if="{{item.author}}">{{item.author}}</view>
          <text class="pb-tag pb-tag--on" wx:if="{{item.inShelf}}">在我的书架</text>
          <view class="pb-reading" wx:if="{{item.readingCount}}">{{item.readingCount}} 人在读</view>
        </view>
      </view>
    </view>

    <wre-state
      wx:elif="{{!linkLoading && !linkError && linkSearched}}"
      type="empty"
      text="没搜到"
      sub="换个书名试试；也可能微信读书没有这本的电子版"
    />

    <view class="pb-foot">
      <button class="wre-btn wre-btn--ghost" bindtap="onLinkCancel">返回</button>
    </view>
  </block>

  <!-- ========== 笔记明细视图（M5）========== -->
  <block wx:elif="{{view === 'notes'}}">
    <view class="wre-card">
      <view class="wre-title">{{editing.linkTitle || editing.title}}</view>
      <view class="wre-muted">微信读书里这本的划线 / 想法（只读，不修改）</view>
    </view>

    <wre-state wx:if="{{noteItemsLoading}}" type="loading" text="正在读取笔记…" />
    <view class="wre-card pb-error" wx:elif="{{noteItemsError}}">{{noteItemsError}}</view>
    <wre-state
      wx:elif="{{!noteItems.marks.length && !noteItems.reviews.length}}"
      type="empty"
      text="这本还没有笔记"
      sub="在微信读书里划线或写想法后，这里就能看到"
    />

    <block wx:else>
      <view class="wre-card" wx:if="{{noteItems.reviews.length}}">
        <view class="wre-title">想法 / 点评（{{noteItems.reviews.length}}）</view>
        <view class="pb-note-item" wx:for="{{noteItems.reviews}}" wx:key="index">
          <view class="pb-note-text">{{item.text}}</view>
        </view>
      </view>

      <view class="wre-card" wx:if="{{noteItems.marks.length}}">
        <view class="wre-title">划线（{{noteItems.marks.length}}）</view>
        <view class="pb-note-item" wx:for="{{noteItems.marks}}" wx:key="index">
          <view class="pb-note-text">{{item.text}}</view>
        </view>
      </view>
    </block>

    <view class="pb-foot">
      <button class="wre-btn wre-btn--ghost" bindtap="onNotesBack">返回详情</button>
    </view>
  </block>
</view>
