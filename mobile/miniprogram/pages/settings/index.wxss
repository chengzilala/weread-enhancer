.settings-status {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.settings-status--ok {
  color: var(--wre-tag-fg);
}

.settings-status--error {
  color: var(--wre-danger);
}

.settings-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--wre-soft);
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

.settings-help {
  color: var(--wre-muted);
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
}

.settings-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.settings-link__label {
  font-size: calc(30rpx * var(--wre-fs));
  color: var(--wre-text);
}

/* 运营入口：标题 + 说明两行，箭头右侧对齐 */
.settings-link__main {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 16rpx;
}

.settings-link__desc {
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.settings-link__arrow {
  color: var(--wre-arrow);
  font-size: calc(36rpx * var(--wre-fs));
}

/* 反馈与交流：单张微信二维码（小程序内不得出现打赏 / 收款码） */
.feedback-code {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
}

.feedback-qr {
  width: 440rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--wre-line);
  background: #fff;
}

.feedback-label {
  margin-top: 12rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

/* 文字大小（四档切换，对齐 H5 .wre-modes / .wre-mode） */
.fs-modes {
  display: flex;
  background: var(--wre-soft);
  border-radius: 12rpx;
  padding: 6rpx;
  margin-top: 20rpx;
}

.fs-mode {
  flex: 1;
  text-align: center;
  color: var(--wre-muted);
  border-radius: 8rpx;
  padding: 14rpx 0;
  font-size: calc(28rpx * var(--wre-fs));
}

.fs-mode.is-active {
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-weight: 600;
}

/* 统一账户（account-center） */
.ps-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.ps-avatar {
  display: block;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
}

.ps-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--wre-soft);
  color: var(--wre-muted);
  font-size: calc(32rpx * var(--wre-fs));
}

.ps-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.ps-nick {
  display: block;
  font-size: calc(30rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
}

.ps-uid {
  display: block;
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.ps-bind {
  margin-top: 20rpx;
  text-align: center;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-brand);
}

/* 危险操作：注销账户（弱化文字按钮，靠二次确认兜底） */
.acc-danger {
  margin-top: 28rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: calc(24rpx * var(--wre-fs));
  color: #e54545;
  opacity: 0.85;
}

/* 参数详情（放在「更多」折叠区里） */
.params {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--wre-line);
}

.params__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
}

.params__row:last-child {
  border-bottom: none;
}

.params__label {
  flex-shrink: 0;
  margin-right: 24rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.params__value {
  flex: 1;
  text-align: right;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-text);
  word-break: break-all;
}

/* 「如何获取 Key」图文说明（展开在 .wre-acc 里） */
.key-guide__step {
  margin-top: 24rpx;
}

.key-guide__row {
  display: flex;
  align-items: flex-start;
}

.key-guide__no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-size: calc(24rpx * var(--wre-fs));
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}

.key-guide__text {
  flex: 1;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.7;
  color: var(--wre-text-body);
}

.key-guide__img {
  display: block;
  width: 62%;
  margin: 16rpx 0 0;
  border: 1rpx solid var(--wre-line);
  border-radius: 20rpx;
  background: #fff;
}

.key-guide__tip {
  margin-top: 28rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.65;
  color: var(--wre-muted);
}

/* ---- 我的（重构）：重点卡 / 状态胶囊 / 统一折叠行 ---- */
/* 未配置 Key 时给核心卡一点品牌底，提示这是当前最该做的事 */
.wre-card--hero {
  box-shadow: 0 0 0 2rpx var(--wre-brand-soft);
}

.wre-title--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wre-chip {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--wre-soft);
  color: var(--wre-muted);
  font-size: calc(22rpx * var(--wre-fs));
  font-weight: 500;
}

.wre-chip.is-on {
  background: var(--wre-brand-soft);
  color: var(--wre-brand);
}

/* 统一折叠行：左标签 + 右侧当前值 + 箭头 */
.wre-row {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
  font-size: calc(30rpx * var(--wre-fs));
  color: var(--wre-text);
}

.wre-row:last-child {
  border-bottom: none;
}

/* 静态行（不可点，如「统一账户」直接展开的标题行） */
.wre-row--static {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.wre-row__label {
  flex: 1;
  min-width: 0;
}

.wre-row__val {
  flex: none;
  max-width: 46%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.wre-row__arrow {
  flex: none;
  margin-left: 12rpx;
  color: var(--wre-arrow);
  font-size: calc(22rpx * var(--wre-fs));
}

.wre-row__link {
  flex: none;
  padding: 8rpx 0 8rpx 20rpx;
  color: var(--wre-brand);
  font-size: calc(26rpx * var(--wre-fs));
}

/* 折叠面板：展开后紧贴所属行 */
.wre-acc {
  padding: 8rpx 0 28rpx;
  border-bottom: 1rpx solid var(--wre-line);
}

.wre-acc:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.wre-acc__label {
  margin: 20rpx 0 12rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.wre-acc .fs-modes,
.wre-acc .theme-modes {
  background: var(--wre-card-2);
  margin-top: 0;
}

.wre-hint {
  margin-top: 16rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.7;
  color: var(--wre-muted);
}

/* 账户码行：标签 + 等宽值 + 文字按钮 */
.wre-code-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--wre-line);
}

.wre-code-row__label {
  flex: none;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.wre-code-row__val {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: Menlo, Consolas, monospace;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-text);
}

/* 卡片内按钮行（次要操作并排） */
.wre-btn-row {
  display: flex;
  margin-top: 24rpx;
}

.wre-btn-row .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.wre-btn-row .wre-btn:last-child {
  margin-right: 0;
}

/* 页尾：退出登录（弱化） */
.wre-foot {
  padding: 8rpx 8rpx 40rpx;
  text-align: center;
}

.wre-foot__btn {
  display: inline-block;
  padding: 16rpx 24rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
  text-decoration: underline;
}

/* 「装到桌面」分步说明（展开在 .wre-acc 里） */
.desktop-guide__group {
  margin-top: 24rpx;
}

.desktop-guide__group-title {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
  margin-bottom: 12rpx;
}

.desktop-guide__row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.desktop-guide__no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-size: calc(24rpx * var(--wre-fs));
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}

.desktop-guide__text {
  flex: 1;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.7;
  color: var(--wre-text-body);
}

.desktop-guide__tip {
  margin-top: 28rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.65;
  color: var(--wre-muted);
}

