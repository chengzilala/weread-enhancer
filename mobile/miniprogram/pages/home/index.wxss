/* 周期切换 */
.period {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.period__item {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #8A8F99;
  border-radius: 12rpx;
}

.period__item--active {
  background: #2F6BFF;
  color: #FFFFFF;
  font-weight: 600;
}

/* 指标卡片（2 × 2） */
.metrics {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.metric {
  width: 48%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.metric__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2F6BFF;
}

.metric__label {
  font-size: 26rpx;
  color: #1F2430;
  margin-top: 8rpx;
}

.metric__hint {
  font-size: 22rpx;
  color: #A8ADB8;
  margin-top: 6rpx;
}

.cache-hint {
  text-align: center;
}
