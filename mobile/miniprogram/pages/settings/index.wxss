.settings-status {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8A8F99;
}

.settings-status--ok {
  color: #12A150;
}

.settings-status--error {
  color: #E54545;
}

.settings-mask {
  color: #1F2430;
  font-weight: 600;
}

.settings-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.settings-help {
  color: #8A8F99;
  font-size: 26rpx;
  line-height: 1.9;
}

.settings-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.settings-link__label {
  font-size: 30rpx;
  color: #1F2430;
}

.settings-link__arrow {
  color: #C0C4CC;
  font-size: 36rpx;
}

/* 我的资料 */
.profile-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.profile-avatar-btn {
  padding: 0;
  margin: 0;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 60rpx;
  overflow: hidden;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  display: block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F6F8;
  color: #A8ADB8;
  font-size: 26rpx;
}

.profile-nick {
  flex: 1;
  margin-left: 28rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
}
