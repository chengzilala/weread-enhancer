/* 阅读报告页 */

.cache-hint {
  text-align: center;
  margin-bottom: 8rpx;
}

/* 周期切换 */
.period {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.period__item {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #8A8F99;
  border-radius: 12rpx;
}

.period__item--active {
  background: #2F6BFF;
  color: #FFFFFF;
  font-weight: 600;
}

/* 元素信息卡 */
.meta__row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}

.meta__k {
  color: #8A8F99;
  font-size: 26rpx;
}

.meta__v {
  color: #1F2430;
  font-size: 26rpx;
  max-width: 60%;
  text-align: right;
}

/* 章节标题 */
.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2430;
  margin: 28rpx 8rpx 16rpx;
}

.sec-title--sub {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A5060;
  margin: 20rpx 8rpx 12rpx;
}

/* 键值表 */
.kv__row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.kv__k {
  color: #8A8F99;
  font-size: 27rpx;
}

.kv__v {
  color: #1F2430;
  font-size: 27rpx;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
}

/* 指标卡片 */
.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cards__item {
  width: 48%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.cards__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2F6BFF;
}

.cards__label {
  font-size: 24rpx;
  color: #1F2430;
  margin-top: 8rpx;
}

/* 表格 */
.table-card {
  padding: 20rpx 24rpx;
}

.tbl__row {
  display: flex;
  position: relative;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.tbl__row--head .tbl__cell {
  color: #8A8F99;
  font-size: 24rpx;
  font-weight: 600;
}

.tbl__cell {
  flex: 1;
  font-size: 26rpx;
  color: #1F2430;
  word-break: break-all;
}

.tbl__bar {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 4rpx;
  background: #2F6BFF;
  opacity: 0.25;
  border-radius: 4rpx;
}

/* 官方概要标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #F0F4FF;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip__label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-right: 12rpx;
}

.chip__value {
  font-size: 26rpx;
  color: #2F6BFF;
  font-weight: 600;
}

/* 段落 */
.para {
  font-size: 28rpx;
  line-height: 1.8;
  color: #2A2F3A;
}

/* 列表 */
.list__item {
  display: flex;
  padding: 8rpx 0;
}

.list__mark {
  color: #2F6BFF;
  font-size: 26rpx;
  margin-right: 12rpx;
  min-width: 32rpx;
}

.list__text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.8;
  color: #2A2F3A;
}

/* 提示 / 空态 */
.note {
  padding: 8rpx 8rpx 16rpx;
}
