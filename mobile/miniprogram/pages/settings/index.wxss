.settings-status {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.settings-status--ok {
  color: var(--wre-tag-fg);
}

.settings-status--error {
  color: var(--wre-danger);
}

.settings-mask {
  color: var(--wre-text);
  font-weight: 600;
}

.settings-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--wre-soft);
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

.settings-help {
  color: var(--wre-muted);
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
}

.settings-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.settings-link__label {
  font-size: calc(30rpx * var(--wre-fs));
  color: var(--wre-text);
}

/* 运营入口：标题 + 说明两行，箭头右侧对齐 */
.settings-link__main {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 16rpx;
}

.settings-link__desc {
  margin-top: 6rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.settings-link__arrow {
  color: var(--wre-arrow);
  font-size: calc(36rpx * var(--wre-fs));
}

/* 文字大小（四档切换，对齐 H5 .wre-modes / .wre-mode） */
.fs-modes {
  display: flex;
  background: var(--wre-soft);
  border-radius: 12rpx;
  padding: 6rpx;
  margin-top: 20rpx;
}

.fs-mode {
  flex: 1;
  text-align: center;
  color: var(--wre-muted);
  border-radius: 8rpx;
  padding: 14rpx 0;
  font-size: calc(28rpx * var(--wre-fs));
}

.fs-mode.is-active {
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-weight: 600;
}

/* 我的资料 */
.profile-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.profile-avatar-btn {
  padding: 0;
  margin: 0;
  width: 120rpx;
  height: 120rpx;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 60rpx;
  overflow: hidden;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  display: block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--wre-soft);
  color: var(--wre-muted);
  font-size: calc(26rpx * var(--wre-fs));
}

.profile-nick {
  flex: 1;
  margin-left: 28rpx;
  padding: 24rpx;
  background: var(--wre-soft);
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

/* 保存 / 清除 一行 */
.settings-actions {
  display: flex;
  margin-top: 24rpx;
}

.settings-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.settings-actions .wre-btn:last-child {
  margin-right: 0;
}

/* 参数详情（默认收起，点标题展开） */
.settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings-toggle__label {
  font-size: calc(34rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
}

.settings-toggle__action {
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-brand);
}

.params {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--wre-line);
}

.params__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
}

.params__row:last-child {
  border-bottom: none;
}

.params__label {
  flex-shrink: 0;
  margin-right: 24rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.params__value {
  flex: 1;
  text-align: right;
  font-size: calc(26rpx * var(--wre-fs));
  color: var(--wre-text);
  word-break: break-all;
}

.params__note {
  margin-top: 16rpx;
}

/* 「如何获取 Key」图文说明（对齐 H5 .wre-guide；默认收起，点标题展开） */
.key-guide {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: var(--wre-card-2);
  border: 1rpx solid var(--wre-line);
  border-radius: 24rpx;
}

.key-guide__summary {
  flex: 1;
  font-size: calc(26rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-brand);
}

.key-guide__arrow {
  flex: none;
  margin-left: 16rpx;
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
}

.key-guide__body {
  margin-top: 8rpx;
  padding: 0 24rpx 8rpx;
}

.key-guide__step {
  margin-top: 24rpx;
}

.key-guide__row {
  display: flex;
  align-items: flex-start;
}

.key-guide__no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-size: calc(24rpx * var(--wre-fs));
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}

.key-guide__text {
  flex: 1;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.7;
  color: var(--wre-text-body);
}

.key-guide__img {
  display: block;
  width: 62%;
  margin: 16rpx 0 0;
  border: 1rpx solid var(--wre-line);
  border-radius: 20rpx;
  background: #fff;
}

.key-guide__tip {
  margin-top: 28rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.65;
  color: var(--wre-muted);
}

/* 「加到手机桌面 / 我的小程序」：置顶卡片，淡品牌底突出显示 */
.desktop-card {
  background: var(--wre-brand-soft);
}

.desktop-guide__group {
  margin-top: 24rpx;
}

.desktop-guide__group-title {
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: var(--wre-text);
  margin-bottom: 12rpx;
}

.desktop-guide__row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.desktop-guide__no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--wre-brand);
  color: var(--wre-on-brand);
  font-size: calc(24rpx * var(--wre-fs));
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}

.desktop-guide__text {
  flex: 1;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.7;
  color: var(--wre-text-body);
}

.desktop-guide__tip {
  margin-top: 28rpx;
  font-size: calc(24rpx * var(--wre-fs));
  line-height: 1.65;
  color: var(--wre-muted);
}

