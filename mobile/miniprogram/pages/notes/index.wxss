/* 笔记概览：统计卡 + 笔记最多的书 */

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-metric {
  width: 48%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.card-metric__value {
  font-size: 38rpx;
  font-weight: 700;
  color: #2F6BFF;
}

.card-metric__label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

.note-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.note-item:last-child {
  border-bottom: none;
}

.note-item__title {
  font-size: 30rpx;
  color: #1F2430;
}

.note-item__author {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 6rpx;
}

.note-item__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #2F6BFF;
  background: #F0F4FF;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin: 0 16rpx 8rpx 0;
}

.more {
  text-align: center;
  margin-top: 16rpx;
}
