/* 书架：概览 + 分类 + 电子书 / 专辑列表 */

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-metric {
  width: 48%;
  box-sizing: border-box;
  background: var(--wre-card);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.card-metric__value {
  font-size: calc(38rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-brand);
}

.card-metric__label {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  margin-top: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: var(--wre-brand-soft);
  color: var(--wre-brand);
  font-size: calc(24rpx * var(--wre-fs));
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.more {
  text-align: center;
  margin-top: 16rpx;
}

/* 生成竖版分享图入口 */
.share-entry {
  text-align: center;
}

.share-entry .wre-muted {
  margin-top: 4rpx;
}

/* 离屏绘制画布（尺寸需与 shelf-share.js 中的画布缓冲一致：1080×3200） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: calc(28rpx * var(--wre-fs));
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}
