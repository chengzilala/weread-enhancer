.link-loading {
  margin-top: 20rpx;
}

/* 扫一扫：主操作，置于手动输入之上 */
.link-scan {
  margin-top: 24rpx;
}

/* 分区小标题（情况一 / 情况二） */
.link-sec {
  margin-top: 32rpx;
  font-size: calc(28rpx * var(--wre-fs));
  font-weight: 600;
  color: #1F2430;
}

/* 我的账户码 */
.link-code {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: calc(30rpx * var(--wre-fs));
  letter-spacing: 1rpx;
  color: #1F2430;
  word-break: break-all;
}

.link-code__ops {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}

.link-code__op {
  font-size: calc(28rpx * var(--wre-fs));
  color: #12A150;
}

.link-input {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: calc(28rpx * var(--wre-fs));
}

.link-hint {
  margin-top: 20rpx;
}

.link-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #F0F1F4;
  border-bottom: 1rpx solid #F0F1F4;
}

.link-state__label {
  font-size: calc(30rpx * var(--wre-fs));
  color: #1F2430;
}

.link-state__val {
  font-size: calc(28rpx * var(--wre-fs));
  color: #12A150;
}

.link-status {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--wre-fs));
  color: #8A8F99;
}

.link-status--ok {
  color: #12A150;
}

.link-status--error {
  color: #E54545;
}

.wre-help {
  color: #8A8F99;
  font-size: calc(26rpx * var(--wre-fs));
  line-height: 1.9;
}
