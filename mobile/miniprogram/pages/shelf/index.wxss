/* 书架：概览 + 分类 + 电子书 / 专辑列表 */

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-metric {
  width: 48%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.card-metric__value {
  font-size: 38rpx;
  font-weight: 700;
  color: #2F6BFF;
}

.card-metric__label {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #F0F4FF;
  color: #2F6BFF;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.item:last-child {
  border-bottom: none;
}

.item__cover {
  width: 88rpx;
  height: 118rpx;
  border-radius: 10rpx;
  background: #F0F1F4;
  flex-shrink: 0;
}

.item__main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item__title {
  font-size: 30rpx;
  color: #1F2430;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__sub {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item__tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: #8A8F99;
  background: #F5F6F8;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-bottom: 6rpx;
}

.tag--done {
  color: #2F6BFF;
  background: #F0F4FF;
}

.more {
  text-align: center;
  margin-top: 16rpx;
}
