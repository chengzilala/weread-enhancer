/* 阅读人格页 */

/* 主卡 */
.hero {
  text-align: center;
}

.hero__code {
  display: inline-block;
  background: #2F6BFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  padding: 10rpx 28rpx;
  border-radius: 14rpx;
}

.hero__code-note {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8A8F99;
  line-height: 1.6;
}

.hero__legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 14rpx;
  margin-bottom: 4rpx;
}

.hero__legend-item {
  display: flex;
  align-items: center;
  background: #F0F4FF;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}

.hero__legend-letter {
  font-size: 26rpx;
  font-weight: 700;
  color: #2F6BFF;
  margin-right: 8rpx;
}

.hero__legend-label {
  font-size: 26rpx;
  color: #4A5060;
}

.hero__name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2430;
  margin: 24rpx 0 12rpx;
}

.hero__tagline {
  font-size: 28rpx;
  color: #4A5060;
  line-height: 1.7;
}

.hero__figure {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #F5F7FF;
  border-radius: 16rpx;
}

.hero__figure-img {
  display: block;
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto 16rpx;
}

.hero__figure-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2F6BFF;
}

.hero__figure-line {
  display: block;
  font-size: 26rpx;
  color: #4A5060;
  margin-top: 8rpx;
}

.hero__one-liner {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #2A2F3A;
  line-height: 1.8;
}

/* 标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.chip {
  background: #F0F4FF;
  color: #2F6BFF;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip--strong {
  background: #2F6BFF;
  color: #FFFFFF;
  font-weight: 600;
}

/* 维度 */
.dim {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.dim:last-child {
  border-bottom: none;
}

.dim__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dim__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2430;
}

.dim__side {
  font-size: 24rpx;
  color: #2F6BFF;
}

.dim__side--muted {
  color: #A8ADB8;
}

.dim__bar {
  height: 12rpx;
  background: #EEF1F6;
  border-radius: 8rpx;
  margin: 14rpx 0 10rpx;
  overflow: hidden;
}

.dim__fill {
  height: 100%;
  background: #2F6BFF;
  border-radius: 8rpx;
}

.dim__basis {
  font-size: 24rpx;
  color: #8A8F99;
  line-height: 1.6;
}

/* 列表（判定依据） */
.list__item {
  display: flex;
  padding: 6rpx 0;
}

.list__mark {
  color: #2F6BFF;
  font-size: 26rpx;
  margin-right: 12rpx;
  min-width: 24rpx;
}

.list__text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.8;
  color: #2A2F3A;
}

/* 原文引用 */
.quote {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.quote:last-child {
  border-bottom: none;
}

.quote__text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #2A2F3A;
}

.quote__from {
  font-size: 24rpx;
  color: #8A8F99;
  margin-top: 8rpx;
  text-align: right;
}

/* 词语分析 */
.themes {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0;
}

.theme {
  display: flex;
  align-items: center;
  background: #F5F7FF;
  border-radius: 12rpx;
  padding: 10rpx 18rpx;
  margin: 0 16rpx 16rpx 0;
}

.theme__name {
  font-size: 26rpx;
  color: #1F2430;
}

.theme__count {
  font-size: 24rpx;
  color: #2F6BFF;
  font-weight: 600;
  margin-left: 12rpx;
}

.emotion {
  display: flex;
  margin: 8rpx 0 16rpx;
}

.emotion__item {
  font-size: 25rpx;
  color: #4A5060;
  margin-right: 24rpx;
}

/* 数据不足进度 */
.progress-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F1F4;
}

.progress-k {
  color: #8A8F99;
  font-size: 27rpx;
}

.progress-v {
  color: #1F2430;
  font-size: 27rpx;
  font-weight: 600;
}

/* 声明 */
.statement {
  padding: 8rpx 8rpx 24rpx;
  font-size: 24rpx;
}

/* 生成分享图入口 */
.share-entry {
  text-align: center;
}

.share-entry .wre-muted {
  margin-top: 4rpx;
}

/* AI 人格画像 */
.ai-card .wre-muted {
  margin-bottom: 20rpx;
}

.ai-text {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  line-height: 1.9;
  color: #2A2F3A;
  white-space: pre-wrap;
}

.ai-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #E54545;
  line-height: 1.6;
}

/* 离屏绘制画布（不参与显示；实际绘制缓冲由 persona-share.js 按高清倍率设置） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 3200px;
}

/* 分享图预览弹层 */
.share-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.86);
}

.share-preview {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.share-preview__img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.share-actions {
  display: flex;
  margin-top: 24rpx;
}

.share-actions .wre-btn {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
  padding: 0 8rpx;
}

.share-actions .wre-btn:last-child {
  margin-right: 0;
}
