/* 笔记概览：统计卡 + 笔记最多的书 */

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-metric {
  width: 48%;
  box-sizing: border-box;
  background: var(--wre-card);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}

.card-metric__value {
  font-size: calc(38rpx * var(--wre-fs));
  font-weight: 700;
  color: var(--wre-brand);
}

.card-metric__label {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  margin-top: 8rpx;
}

.note-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--wre-line);
}

.note-item:last-child {
  border-bottom: none;
}

.note-item__title {
  font-size: calc(30rpx * var(--wre-fs));
  color: var(--wre-text);
}

.note-item__author {
  font-size: calc(24rpx * var(--wre-fs));
  color: var(--wre-muted);
  margin-top: 6rpx;
}

.note-item__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.tag {
  font-size: calc(22rpx * var(--wre-fs));
  color: var(--wre-brand);
  background: var(--wre-brand-soft);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin: 0 16rpx 8rpx 0;
}

.more {
  text-align: center;
  margin-top: 16rpx;
}
